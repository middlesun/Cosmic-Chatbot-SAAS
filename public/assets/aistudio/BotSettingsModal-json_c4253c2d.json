import React, { useState } from 'react';
import { ChatSession, ThemeMode } from '../types';

interface BotSettingsModalProps {
  isOpen: boolean;
  onClose: () => void;
  session: ChatSession;
  onUpdateCustomPrompt: (prompt: string) => void;
  onResetChat: () => void;
  onExportChat: () => void;
  theme: ThemeMode;
}

const BotSettingsModal: React.FC<BotSettingsModalProps> = ({
  isOpen,
  onClose,
  session,
  onUpdateCustomPrompt,
  onResetChat,
  onExportChat,
  theme
}) => {
  const [customPrompt, setCustomPrompt] = useState(session.customPrompt || '');
  const isLight = theme === ThemeMode.LIGHT;

  if (!isOpen) return null;

  const handleSave = () => {
    onUpdateCustomPrompt(customPrompt);
    onClose();
  };

  const labelClass = `text-[10px] uppercase font-black tracking-widest mb-1 block opacity-60 ${isLight ? 'text-slate-600' : 'text-slate-400'}`;
  
  return (
    <div className="fixed inset-0 z-[200] flex items-center justify-center p-4">
      <div className="absolute inset-0 bg-black/60 backdrop-blur-md" onClick={onClose} />
      <div className={`relative w-full max-w-md flex flex-col rounded-[2.5rem] border-2 shadow-2xl animate-in zoom-in-95 duration-500 overflow-hidden ${isLight ? 'bg-white border-transparent text-slate-800' : 'bg-slate-900 border-white/10 text-white'}`}>
        <div className="p-8 pb-4 relative shrink-0">
          <button onClick={onClose} className="absolute top-8 right-8 w-10 h-10 flex items-center justify-center rounded-xl bg-black/5 dark:bg-white/5 hover:rotate-90 transition-all opacity-40 hover:opacity-100 z-10 border-none active:scale-90"><i className="fa-solid fa-xmark text-xl"></i></button>
          <h2 className="text-2xl font-serif font-black tracking-tighter text-center">{session.character.name} Settings</h2>
        </div>

        <div className="p-8 pt-2 space-y-6">
          <div>
            <label className={labelClass}>Customize Assistant</label>
            <p className="text-[11px] opacity-50 mb-3 leading-relaxed">Tell the counselor how to address you or what specific focus you want for this chat.</p>
            <textarea
              className={`w-full p-4 rounded-2xl border-2 outline-none focus:ring-2 focus:ring-purple-500/50 transition-all min-h-[120px] resize-none text-sm ${
                isLight ? 'bg-slate-50 border-slate-100 text-slate-900' : 'bg-white/5 border-white/5 text-white'
              }`}
              placeholder="Example: Call me 'Commander'. Focus heavily on my career transits and be very direct."
              value={customPrompt}
              onChange={(e) => setCustomPrompt(e.target.value)}
            />
          </div>

          <div className="grid grid-cols-2 gap-3">
            <button
              onClick={onExportChat}
              className={`flex items-center justify-center gap-2 py-4 rounded-2xl border transition-all text-[10px] font-black uppercase tracking-widest ${
                isLight ? 'bg-white border-purple-100 text-purple-600 hover:bg-purple-50' : 'bg-white/5 border-white/10 text-slate-300 hover:bg-white/10'
              }`}
            >
              <i className="fa-solid fa-download"></i>
              Export Chat
            </button>
            <button
              onClick={() => { if(confirm('Reset this conversation? Customizations will be kept.')) onResetChat(); }}
              className={`flex items-center justify-center gap-2 py-4 rounded-2xl border transition-all text-[10px] font-black uppercase tracking-widest ${
                isLight ? 'bg-white border-rose-100 text-rose-600 hover:bg-rose-50' : 'bg-rose-500/10 border-rose-500/20 text-rose-400 hover:bg-rose-500/20'
              }`}
            >
              <i className="fa-solid fa-rotate-left"></i>
              Reset Chat
            </button>
          </div>

          <button
            onClick={handleSave}
            className="w-full py-5 rounded-2xl bg-gradient-to-tr from-purple-600 to-indigo-700 text-white text-[11px] font-black uppercase tracking-[0.4em] shadow-xl hover:scale-[1.02] active:scale-95 relative overflow-hidden border-none active:outline-none focus:outline-none"
          >
            <div className="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-white/20 to-transparent pointer-events-none"></div>
            <span className="relative z-10">Save Customization</span>
          </button>
        </div>
      </div>
    </div>
  );
};

export default BotSettingsModal;