import React, { useState } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI, Type } from '@google/genai';

interface PlanetStrengthTesterAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const PLANETS = ["Sun", "Moon", "Mars", "Mercury", "Jupiter", "Venus", "Saturn"];

const PlanetStrengthTesterApp: React.FC<PlanetStrengthTesterAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [selectedPlanet, setSelectedPlanet] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);
  const [questions, setQuestions] = useState<any[]>([]);
  const [currentStep, setCurrentStep] = useState<'select' | 'quiz' | 'result'>('select');
  const [answers, setAnswers] = useState<number[]>([]);
  const [result, setResult] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const startQuiz = async (planet: string) => {
    setSelectedPlanet(planet);
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const prompt = `Generate a 5-question multiple choice quiz to test the functional strength of the planet ${planet} in a user's life. 
    Questions should relate to real-world experiences (e.g., for Mars, ask about drive and anger). 
    Each question must have 4 options with point values (1 to 4).
    Return as a JSON array of objects: { "question": "...", "options": ["...", "...", "...", "..."] }`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
        config: { responseMimeType: "application/json" }
      });
      const data = JSON.parse(response.text || "[]");
      setQuestions(data);
      setCurrentStep('quiz');
      setAnswers([]);
    } catch (error) {
      alert("Error generating quiz. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  const submitQuiz = async () => {
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const totalScore = answers.reduce((a, b) => a + b, 0);
    const context = userProfile ? `User Born ${userProfile.dob}.` : "";
    const prompt = `${context}
    The user took a strength test for ${selectedPlanet}. Total raw score: ${totalScore}/20 (where 20 is very positive/strong).
    Provide a detailed 3nd-person analysis of how ${selectedPlanet} is currently acting on their life.
    Include:
    - Status (Positive / Afflicted / Neutral)
    - Life Impacts (Behavioral patterns)
    - Remedy (Practical task to strengthen it)
    IMPORTANT: Use Headers (###). Use Bold (**) for status. Use different color keywords in description.
    Tone: Professional, insightful, and corrective.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setResult(response.text || "The analysis failed.");
      setCurrentStep('result');
    } catch (error) {
      alert("Error calculating result.");
    } finally {
      setLoading(false);
    }
  };

  const handleAnswer = (score: number) => {
    const newAnswers = [...answers, score];
    if (newAnswers.length === questions.length) {
      setAnswers(newAnswers);
      setTimeout(() => submitQuiz(), 100);
    } else {
      setAnswers(newAnswers);
    }
  };

  const handleCopy = () => {
    if (!result) return;
    navigator.clipboard.writeText(result);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-3xl font-black text-cyan-400 mb-8 mt-10" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-blue-400 font-black" {...props} />,
    p: ({node, ...props}: any) => <p className="leading-relaxed mb-4 last:mb-0" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`w-12 h-12 flex items-center justify-center rounded-full transition-all shadow-lg border-2 ${isLight ? 'bg-white border-purple-50 text-purple-600 hover:border-purple-400' : 'bg-slate-900 border-white/5 text-purple-400 hover:border-white/20'}`} title="Back to Apps">
             <i className="fa-solid fa-arrow-left text-lg"></i>
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Planet Strength Tester</h2>
           <div className="w-12" />
        </div>

        {currentStep === 'select' && (
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 w-full">
            {PLANETS.map(p => (
              <button 
                key={p}
                onClick={() => startQuiz(p)}
                disabled={loading}
                className={`p-8 rounded-3xl border-2 flex flex-col items-center gap-4 transition-all hover:scale-105 active:scale-95 ${
                  isLight ? 'bg-white border-purple-50 hover:border-purple-200' : 'bg-slate-900/60 border-white/5 hover:border-cyan-500/30'
                }`}
              >
                <div className="w-12 h-12 rounded-full bg-cyan-500/10 flex items-center justify-center text-cyan-500">
                  <i className="fa-solid fa-meteor text-2xl"></i>
                </div>
                <span className="font-black uppercase tracking-widest text-[10px]">{p}</span>
              </button>
            ))}
          </div>
        )}

        {currentStep === 'quiz' && (
          <div className="w-full max-w-xl space-y-8">
            <div className="flex justify-between items-center px-2">
               <span className="text-[10px] font-black uppercase tracking-widest opacity-40">Testing {selectedPlanet}</span>
               <span className="text-[10px] font-black uppercase tracking-widest opacity-40">Question {answers.length + 1} of {questions.length}</span>
            </div>
            <div className={`p-8 md:p-12 rounded-[3rem] border-2 shadow-xl ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900 border-white/5'}`}>
              <h3 className="text-2xl font-serif font-black mb-8 leading-tight">{questions[answers.length]?.question}</h3>
              <div className="grid gap-3">
                {questions[answers.length]?.options.map((opt: string, idx: number) => (
                  <button 
                    key={idx}
                    onClick={() => handleAnswer(idx + 1)}
                    className={`p-4 rounded-2xl border-2 text-left text-sm font-bold transition-all hover:bg-cyan-500 hover:text-white ${
                      isLight ? 'bg-slate-50 border-purple-50 text-slate-700' : 'bg-white/5 border-white/10 text-slate-300'
                    }`}
                  >
                    {opt}
                  </button>
                ))}
              </div>
            </div>
          </div>
        )}

        {currentStep === 'result' && (
          <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden transition-all duration-500 ${
            isLight ? 'bg-white border-purple-50' : 'bg-slate-900/40 border-cyan-500/10 backdrop-blur-xl'
          }`}>
            <div className="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-cyan-400 to-blue-600"></div>
            <div className="absolute top-6 right-8">
               <button onClick={handleCopy} className={`p-2.5 rounded-xl border-2 transition-all ${copied ? 'text-emerald-400 border-emerald-400' : 'text-cyan-400/40 hover:text-cyan-400 border-cyan-500/20'}`}>
                  <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
               </button>
            </div>
            <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
              <ReactMarkdown components={markdownComponents}>{result || ""}</ReactMarkdown>
            </div>
            <button onClick={() => setCurrentStep('select')} className="mt-12 px-8 py-4 rounded-2xl bg-cyan-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl">Test Another Planet</button>
          </div>
        )}

        {loading && (
          <div className="fixed inset-0 z-[110] bg-black/60 backdrop-blur-sm flex flex-col items-center justify-center gap-6">
             <div className="w-16 h-16 rounded-full border-4 border-cyan-500 border-t-transparent animate-spin"></div>
             <p className="text-xl font-serif italic text-white animate-pulse">Consulting the planetary council...</p>
          </div>
        )}

        <button onClick={onBack} className={`mt-16 mb-8 px-12 py-5 rounded-2xl font-black uppercase tracking-widest transition-all shadow-xl hover:scale-105 active:scale-95 ${isLight ? 'bg-white border-2 border-purple-100 text-purple-600' : 'bg-slate-900 border-2 border-white/5 text-purple-400'}`}>
          <i className="fa-solid fa-arrow-left mr-3"></i>
          Back to Apps
        </button>
      </div>
    </div>
  );
};

export default PlanetStrengthTesterApp;