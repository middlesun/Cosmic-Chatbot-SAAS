import React, { useState } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface LoveCompatibilityAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const LoveCompatibilityApp: React.FC<LoveCompatibilityAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [partnerName, setPartnerName] = useState("");
  const [partnerDob, setPartnerDob] = useState("");
  const [report, setReport] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const testCompatibility = async () => {
    if (!partnerDob || !userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const prompt = `Perform a deep Love Compatibility Test between:
    Person A (User): ${userProfile.firstName}, Born ${userProfile.dob}.
    Person B (Partner): ${partnerName}, Born ${partnerDob}.
    Analyze:
    1. Synastry Highlights: Major planetary aspects between charts.
    2. Numerological Vibration: Match score based on life paths.
    3. Cosmic Match Score: A final percentage (0-100%).
    4. Breakup-Proofing: 3 practical tips to handle their specific planetary frictions.
    IMPORTANT: Use Headers (###). Use bold (**) for the Cosmic Match Score. Use color-coded sections for Synastry vs Numerology.
    Tone: Deeply insightful, realistic, and empowering.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setReport(response.text || "The charts are clashing too hard to read.");
    } catch (error) {
      setReport("The cosmic alignment for this match failed.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!report) return;
    navigator.clipboard.writeText(report);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-3xl font-black text-indigo-400 mb-8 mt-10 tracking-tighter" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-blue-400 font-black" {...props} />,
    p: ({node, ...props}: any) => <p className="leading-relaxed mb-4 last:mb-0" {...props} />,
    em: ({node, ...props}: any) => <em className="text-indigo-300 italic" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`w-12 h-12 flex items-center justify-center rounded-full transition-all shadow-lg border-2 ${isLight ? 'bg-white border-purple-50 text-purple-600 hover:border-purple-400' : 'bg-slate-900 border-white/5 text-purple-400 hover:border-white/20'}`} title="Back to Apps">
             <i className="fa-solid fa-arrow-left text-lg"></i>
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Love Compatibility</h2>
           <div className="w-12" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-link text-5xl text-indigo-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Your Data Needed</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">We need your birth chart to compare it with your partner's.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-indigo-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-indigo-500/20">Set Up Profile</button>
          </div>
        ) : (
          <div className="w-full space-y-8">
            <div className={`p-8 rounded-[3rem] border-2 shadow-xl ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
                <div>
                  <label className="text-[10px] uppercase font-black tracking-widest mb-1 block opacity-60">Partner's Name</label>
                  <input type="text" className={`w-full p-3 rounded-xl border outline-none ${isLight ? 'bg-white border-slate-200' : 'bg-white/5 border-white/10 text-white'}`} value={partnerName} onChange={e => setPartnerName(e.target.value)} placeholder="Alex" />
                </div>
                <div>
                  <label className="text-[10px] uppercase font-black tracking-widest mb-1 block opacity-60">Partner's Birth Date</label>
                  <input type="date" className={`w-full p-3 rounded-xl border outline-none ${isLight ? 'bg-white border-slate-200' : 'bg-white/5 border-white/10 text-white'}`} value={partnerDob} onChange={e => setPartnerDob(e.target.value)} />
                </div>
              </div>
              <button 
                disabled={loading || !partnerDob}
                onClick={testCompatibility}
                className="w-full py-5 rounded-2xl bg-gradient-to-tr from-indigo-500 to-blue-700 text-white text-[11px] font-black uppercase tracking-[0.4em] shadow-xl hover:scale-[1.02] active:scale-95 transition-all disabled:opacity-30"
              >
                {loading ? 'Analyzing Synastry Aspects...' : 'Test Our Cosmic Match'}
              </button>
            </div>

            {report && !loading && (
              <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden animate-in fade-in slide-in-from-top-4 duration-1000 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/40 border-indigo-500/10 backdrop-blur-xl'}`}>
                <div className="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-indigo-400 via-blue-500 to-indigo-700"></div>
                <div className="absolute top-6 right-8">
                   <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-indigo-500/20 hover:bg-indigo-600 hover:text-white'}`}>
                      <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                      {copied ? 'Copied' : 'Copy Analysis'}
                   </button>
                </div>
                <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
                  <ReactMarkdown components={markdownComponents}>{report}</ReactMarkdown>
                </div>
              </div>
            )}
          </div>
        )}

        <button onClick={onBack} className={`mt-16 mb-8 px-12 py-5 rounded-2xl font-black uppercase tracking-widest transition-all shadow-xl hover:scale-105 active:scale-95 ${isLight ? 'bg-white border-2 border-purple-100 text-purple-600' : 'bg-slate-900 border-2 border-white/5 text-purple-400'}`}>
          <i className="fa-solid fa-arrow-left mr-3"></i>
          Back to Apps
        </button>
      </div>
    </div>
  );
};

export default LoveCompatibilityApp;