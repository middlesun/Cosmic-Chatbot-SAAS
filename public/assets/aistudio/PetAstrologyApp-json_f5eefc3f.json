import React, { useState } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface PetAstrologyAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const PetAstrologyApp: React.FC<PetAstrologyAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [petName, setPetName] = useState("");
  const [petDob, setPetDob] = useState("");
  const [report, setReport] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const analyzePet = async () => {
    if (!petDob || !petName) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const ownerContext = userProfile ? `Owner Profile: Born ${userProfile.dob}.` : "";
    const prompt = `${ownerContext}
    Pet Name: ${petName}. Pet Adoption/Birth Date: ${petDob}.
    1. Generate a "Paw Print Chart" based on this date (Zodiac traits for the pet).
    2. Explain their personality (e.g., 'Your dog’s Leo rising explains the diva demands').
    3. Human-Pet Compatibility: How their energy syncs with the owner.
    IMPORTANT: Use Headers (###). Use Bold (**) for pet signs. Use colorful animal emojis.
    Tone: Heartwarming, playful, and charmingly astrological.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setReport(response.text || "The pet records are unavailable.");
    } catch (error) {
      setReport("The celestial pet park is closed for maintenance.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!report) return;
    navigator.clipboard.writeText(report);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-3xl font-black text-orange-500 mb-6 mt-8" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-red-400 font-black" {...props} />,
    p: ({node, ...props}: any) => <p className="leading-relaxed mb-4 last:mb-0" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`w-12 h-12 flex items-center justify-center rounded-full transition-all shadow-lg border-2 ${isLight ? 'bg-white border-purple-50 text-purple-600 hover:border-purple-400' : 'bg-slate-900 border-white/5 text-purple-400 hover:border-white/20'}`} title="Back to Apps">
             <i className="fa-solid fa-arrow-left text-lg"></i>
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Pet Astrology</h2>
           <div className="w-12" />
        </div>

        <div className="w-full space-y-8">
          <div className={`p-8 rounded-[3rem] border-2 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
              <div>
                <label className="text-[10px] uppercase font-black tracking-widest mb-1 block opacity-60">Pet's Name</label>
                <input type="text" className={`w-full p-3 rounded-xl border outline-none ${isLight ? 'bg-white' : 'bg-white/5 text-white'}`} value={petName} onChange={e => setPetName(e.target.value)} placeholder="Buddy" />
              </div>
              <div>
                <label className="text-[10px] uppercase font-black tracking-widest mb-1 block opacity-60">Adoption/Birth Date</label>
                <input type="date" className={`w-full p-3 rounded-xl border outline-none ${isLight ? 'bg-white' : 'bg-white/5 text-white'}`} value={petDob} onChange={e => setPetDob(e.target.value)} />
              </div>
            </div>
            <button 
              disabled={loading || !petName || !petDob}
              onClick={analyzePet}
              className="w-full py-5 rounded-2xl bg-gradient-to-tr from-orange-400 to-red-600 text-white text-[11px] font-black uppercase tracking-[0.4em] shadow-xl hover:scale-[1.02] active:scale-95 transition-all disabled:opacity-30"
            >
              {loading ? 'Reading the Paw Prints...' : 'Decode My Pet'}
            </button>
          </div>

          {report && !loading && (
            <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden animate-in fade-in slide-in-from-top-4 duration-1000 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/40 border-orange-500/10 backdrop-blur-xl'}`}>
              <div className="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-orange-400 to-red-600"></div>
              <div className="absolute top-6 right-8">
                 <button onClick={handleCopy} className={`p-2.5 rounded-xl border-2 transition-all ${copied ? 'text-emerald-400 border-emerald-400' : 'text-orange-400/40 hover:text-orange-400 border-orange-500/20'}`}>
                    <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                 </button>
              </div>
              <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
                <ReactMarkdown components={markdownComponents}>{report}</ReactMarkdown>
              </div>
            </div>
          )}
        </div>

        <button onClick={onBack} className={`mt-16 mb-8 px-12 py-5 rounded-2xl font-black uppercase tracking-widest transition-all shadow-xl hover:scale-105 active:scale-95 ${isLight ? 'bg-white border-2 border-purple-100 text-purple-600' : 'bg-slate-900 border-2 border-white/5 text-purple-400'}`}>
          <i className="fa-solid fa-arrow-left mr-3"></i>
          Back to Apps
        </button>
      </div>
    </div>
  );
};

export default PetAstrologyApp;