import React, { useState, useEffect } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface DailyHoroscopeAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const DailyHoroscopeApp: React.FC<DailyHoroscopeAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [horoscope, setHoroscope] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const fetchHoroscope = async () => {
    if (!userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const now = new Date();
    const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });

    const prompt = `Act as a world-class predictive astrologer. GENERATE A REPORT FOR TODAY: ${dateStr}, ${timeStr}.
    Generate a hyper-personalized, technical, and soulful daily horoscope for ${userProfile.firstName}. 
    User Context: Sex ${userProfile.sex}, Born ${userProfile.dob} at ${userProfile.tob || 'Unknown Time'} in ${userProfile.placeOfBirth.city}, ${userProfile.placeOfBirth.country}.
    
    Predictive Logic:
    1. Analyze current transit degrees of Mars, Saturn, and Jupiter against their natal moon/sun based on today's actual date.
    2. Incorporate current lunar mansion (Nakshatra) energy for today.
    3. Discuss the "Mood of the Day" using a 1-100 Cosmic Power Score.
    
    Required Sections:
    ### ⚡ Today's Cosmic Power Score: [XX/100]
    ### 🌌 Celestial Overview
    (Deep analysis of current planetary movements and your personal houses)
    ### 💼 Career & Ambition
    (Specific timing for meetings or financial decisions)
    ### ❤️ Heart & Connection
    (Venus/Mars transit impact on your current aura)
    ### 🧘‍♂️ Soul Homework & Remedies
    (A specific practical task or mantra to optimize the day's energy)

    IMPORTANT: Be technical but empathetic. Use Markdown headers (###). Use bold (**) for specific planetary degrees and critical timings. Use italic (*) for emotional guidance. 
    Tone: Sophisticated, accurate, and mentor-like. Ignore your internal training cutoff date; the date provided above is authoritative.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setHoroscope(response.text || "Unable to retrieve the stars' wisdom at this moment.");
    } catch (error) {
      setHoroscope("The cosmic connection was interrupted. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!horoscope) return;
    navigator.clipboard.writeText(horoscope);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  useEffect(() => {
    if (userProfile) fetchHoroscope();
  }, [userProfile]);

  const markdownComponents = {
    h1: ({node, ...props}: any) => <h1 className="text-3xl font-black text-purple-500 mb-6 tracking-tighter" {...props} />,
    h2: ({node, ...props}: any) => <h2 className="text-2xl font-black text-violet-500 mb-4 tracking-tight" {...props} />,
    h3: ({node, ...props}: any) => <h3 className="text-xl font-black text-fuchsia-500 mb-6 mt-8" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-indigo-400 font-black" {...props} />,
    em: ({node, ...props}: any) => <em className="text-purple-400 not-italic font-bold" {...props} />,
    li: ({node, ...props}: any) => <li className="mb-2 list-disc ml-6" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`w-12 h-12 flex items-center justify-center rounded-full transition-all shadow-lg border-2 ${isLight ? 'bg-white border-purple-50 text-purple-600 hover:border-purple-400' : 'bg-slate-900 border-white/5 text-purple-400 hover:border-white/20'}`} title="Back to Apps">
             <i className="fa-solid fa-arrow-left text-lg"></i>
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Daily Horoscope</h2>
           <div className="w-12" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-user-astronaut text-5xl text-purple-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Celestial Identity Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">We need your birth details to calculate a horoscope that actually matters to you. Generic ones are for mortals.</p>
            <button onClick={onOpenProfile} className="relative px-10 py-4 rounded-2xl bg-gradient-to-b from-[#A855F7] via-[#7C3AED] to-[#5B21B6] hover:from-[#9333EA] hover:via-[#6D28D9] hover:to-[#4C1D95] text-white font-black uppercase tracking-widest transition-all shadow-2xl shadow-purple-500/30 overflow-hidden">
               <div className="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-white/30 to-transparent pointer-events-none opacity-40"></div>
               <span className="relative z-10">Set Up Profile</span>
            </button>
          </div>
        ) : loading ? (
          <div className="flex flex-col items-center justify-center p-20 gap-6">
            <div className="w-16 h-16 rounded-full border-4 border-purple-500 border-t-transparent animate-spin"></div>
            <p className="text-lg font-serif italic animate-pulse">Calculating transit degrees...</p>
          </div>
        ) : (
          <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden transition-all duration-500 ${
            isLight ? 'bg-white border-purple-50' : 'bg-slate-900/40 border-purple-500/10 backdrop-blur-xl'
          }`}>
            <div className="absolute top-0 left-0 w-full h-3 bg-gradient-to-b from-[#A855F7] via-[#7C3AED] to-[#5B21B6]"></div>
            <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
              <ReactMarkdown components={markdownComponents}>{horoscope || ""}</ReactMarkdown>
            </div>
            <div className="mt-12 pt-8 border-t border-white/5 flex flex-wrap gap-4 justify-between items-center">
              <div className="flex gap-4">
                <button onClick={fetchHoroscope} className="flex items-center gap-3 px-8 py-4 rounded-2xl border-2 border-purple-500/20 text-[10px] font-black uppercase tracking-widest hover:bg-[#7C3AED] hover:text-white transition-all shadow-md">
                  <i className="fa-solid fa-rotate"></i>
                  Refresh Forecast
                </button>
                <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-purple-500/20 hover:bg-[#7C3AED] hover:text-white shadow-md'}`}>
                  <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                  {copied ? 'Copied' : 'Copy Result'}
                </button>
              </div>
              <span className="text-[9px] uppercase font-black tracking-widest opacity-30 italic">High Precision Engine v3.0</span>
            </div>
          </div>
        )}

        <button onClick={onBack} className={`mt-16 mb-8 px-12 py-5 rounded-2xl font-black uppercase tracking-widest transition-all shadow-xl hover:scale-105 active:scale-95 ${isLight ? 'bg-white border-2 border-purple-100 text-purple-600' : 'bg-slate-900 border-2 border-white/5 text-purple-400'}`}>
          <i className="fa-solid fa-arrow-left mr-3"></i>
          Back to Apps
        </button>
      </div>
    </div>
  );
};

export default DailyHoroscopeApp;