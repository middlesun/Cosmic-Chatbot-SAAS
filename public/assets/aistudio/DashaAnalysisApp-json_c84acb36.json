
import React, { useState, useEffect } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface DashaAnalysisAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const DashaAnalysisApp: React.FC<DashaAnalysisAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [analysis, setAnalysis] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const fetchDasha = async () => {
    if (!userProfile) return;
    setLoading(true);
    // Initialize GoogleGenAI right before making an API call to ensure it uses up-to-date key
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const now = new Date();
    const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });

    const context = `User: ${userProfile.firstName}, Sex: ${userProfile.sex}, Born: ${userProfile.dob} at ${userProfile.tob || 'Unknown Time'} in ${userProfile.placeOfBirth.city}, ${userProfile.placeOfBirth.country}. Today is ${dateStr}, ${timeStr}.`;
    
    const prompt = `${context}
    Perform a high-precision Vedic Dasha Analysis using the Vimshottari Dasha system.
    
    Task:
    1. Identify the likely current Mahadasha and Antardasha (major/minor life cycles) based on the provided birth data.
    2. Explain the core psychological, karmic, and material themes governing this specific period.
    3. Forecast major shifts, opportunities, or challenges for the next 12 months starting from ${dateStr}.
    4. Provide a practical spiritual or behavioral remedy (Upaya) to harmonize with current planetary transits during this dasha.
    
    Technical Requirements:
    - Use technical Vedic terms like Mahadasha, Antardasha, and specific planet names.
    - Format output using Markdown: Headers (###), Bold (**), and Italics (*).
    - Tone: Scholarly, profound, and predictive.
    
    Ignore any internal model training cutoffs; use today's date provided as the source of truth.`;

    try {
      // Use gemini-3-flash-preview for text analysis tasks
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setAnalysis(response.text || "The dasha cycles are currently obscured by cosmic clouds.");
    } catch (error) {
      console.error("Dasha Analysis Error:", error);
      setAnalysis("Could not synchronize with the Vimshottari cycles. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!analysis) return;
    navigator.clipboard.writeText(analysis);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  useEffect(() => {
    if (userProfile) fetchDasha();
  }, [userProfile]);

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-2xl font-black text-orange-500 mb-6 mt-8" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-rose-500 font-black" {...props} />,
    em: ({node, ...props}: any) => <em className="text-amber-500 not-italic font-bold underline" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`flex items-center gap-2 text-xs font-black uppercase tracking-widest transition-all ${isLight ? 'text-orange-600' : 'text-orange-400'}`}>
             <i className="fa-solid fa-arrow-left"></i>
             Back to Apps
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Dasha Analysis</h2>
           <div className="w-20" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-orange-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-timeline text-5xl text-orange-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Birth Details Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">Vimshottari Dasha calculation requires your precise birth timestamp and location to determine your placement in the life cycles.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-orange-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-orange-500/20">Set Up Profile</button>
          </div>
        ) : loading ? (
          <div className="flex flex-col items-center justify-center p-20 gap-6">
            <div className="w-16 h-16 rounded-full border-4 border-orange-500 border-t-transparent animate-spin"></div>
            <p className="text-lg font-serif italic animate-pulse">Calculating Vimshottari cycles...</p>
          </div>
        ) : (
          <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden transition-all duration-500 ${
            isLight ? 'bg-white border-orange-50' : 'bg-slate-900/40 border-orange-500/10 backdrop-blur-xl'
          }`}>
            <div className="absolute top-0 left-0 w-full h-3 bg-gradient-to-r from-orange-400 via-rose-500 to-amber-600"></div>
            <div className="absolute top-6 right-8">
               <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-orange-500/20 hover:bg-orange-600 hover:text-white'}`}>
                  <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                  {copied ? 'Copied' : 'Copy Analysis'}
               </button>
            </div>
            <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
              <ReactMarkdown components={markdownComponents}>{analysis || ""}</ReactMarkdown>
            </div>
            <button onClick={fetchDasha} className="mt-12 px-8 py-4 rounded-2xl border-2 border-orange-500/20 text-[10px] font-black uppercase tracking-widest hover:bg-orange-600 hover:text-white transition-all shadow-lg">Refresh Dasha Cycle</button>
          </div>
        )}
      </div>
    </div>
  );
};

export default DashaAnalysisApp;
