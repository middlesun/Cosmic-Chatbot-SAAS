
import React, { useState, useEffect } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface CareerNavigatorAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const CareerNavigatorApp: React.FC<CareerNavigatorAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [navigation, setNavigation] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const navigateCareer = async () => {
    if (!userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const now = new Date();
    const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });

    const prompt = `Perform an advanced "Vocational Analysis" and "Career Navigator" report for ${userProfile.firstName} BASED ON TODAY: ${dateStr}, ${timeStr}.
    Birth Details: Born ${userProfile.dob} at ${userProfile.tob || 'Unknown'}.
    
    Career Logic:
    1. Midheaven (MC) Analysis: Their public legacy, reputation, and highest professional calling.
    2. The 6th House vs 10th House: Daily grind vs Long-term career growth.
    3. Saturn's Discipline: How they handle authority and responsibility.
    4. Market Alignment: Current global industries they are cosmically "synced" with as of today's date.
    
    Structure:
    ### ⛰️ Your Midheaven Legacy
    (Analysis of your peak vocational potential)
    ### 🛠️ Daily Work Style (6th House)
    (How you best function in an office or remote environment)
    ### 🗺️ Industrial Roadmap
    (3 high-potential career fields for your soul)
    ### 🛡️ Strategic Defense
    (Things to avoid: Karmic pitfalls in the workplace)
    ### 🔮 Next 12-Month Professional Forecast
    (Major transits impacting career starting from ${dateStr})

    IMPORTANT: Use Headers (###). Use bold (**) for career titles and specific dates. Use bullet points for action items.
    Tone: Authoritative, strategic, and highly effective. Use the authoritative date provided and ignore model cutoffs.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setNavigation(response.text || "The path ahead is currently shifting. Try again.");
    } catch (error) {
      setNavigation("Career oracle connection failed.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!navigation) return;
    navigator.clipboard.writeText(navigation);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  useEffect(() => {
    if (userProfile) navigateCareer();
  }, [userProfile]);

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-2xl font-black text-blue-500 mb-10 mt-12 tracking-tighter" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-indigo-400 font-black text-xl" {...props} />,
    p: ({node, ...props}: any) => <p className="leading-relaxed text-lg mb-4 last:mb-0" {...props} />,
    li: ({node, ...props}: any) => <li className="mb-2 list-disc ml-6" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`flex items-center gap-2 text-xs font-black uppercase tracking-widest transition-all ${isLight ? 'text-blue-600' : 'text-blue-400'}`}>
             <i className="fa-solid fa-arrow-left"></i>
             Back to Apps
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter text-blue-500">Career Navigator</h2>
           <div className="w-20" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-blue-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-compass text-5xl text-blue-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Professional Profile Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">We need your 10th house data to map your vocational destiny.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-blue-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-blue-500/20">Set Up Profile</button>
          </div>
        ) : loading ? (
          <div className="flex flex-col items-center justify-center p-20 gap-6">
            <div className="w-16 h-16 rounded-full border-4 border-blue-500 border-t-transparent animate-spin"></div>
            <p className="text-lg font-serif italic animate-pulse text-blue-400">Aligning with your Midheaven...</p>
          </div>
        ) : (
          <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden transition-all duration-500 ${
            isLight ? 'bg-white border-blue-50' : 'bg-slate-900/40 border-blue-500/10 backdrop-blur-xl'
          }`}>
            <div className="absolute top-0 left-0 w-full h-3 bg-gradient-to-r from-blue-400 via-indigo-500 to-purple-600"></div>
            <div className="absolute top-6 right-8">
               <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-blue-500/20 hover:bg-blue-600 hover:text-white'}`}>
                  <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                  {copied ? 'Navigator Saved' : 'Copy Roadmap'}
               </button>
            </div>
            <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
              <ReactMarkdown components={markdownComponents}>{navigation || ""}</ReactMarkdown>
            </div>
            <button onClick={navigateCareer} className="mt-12 px-8 py-4 rounded-2xl border-2 border-blue-500/20 text-[10px] font-black uppercase tracking-widest hover:bg-blue-600 hover:text-white transition-all shadow-lg">Refresh Navigator</button>
          </div>
        )}
      </div>
    </div>
  );
};

export default CareerNavigatorApp;
