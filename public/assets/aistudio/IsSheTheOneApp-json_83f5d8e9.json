import React, { useState } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface IsSheTheOneAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const IsSheTheOneApp: React.FC<IsSheTheOneAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [partnerTraits, setPartnerTraits] = useState("");
  const [currentStep, setCurrentStep] = useState<'input' | 'quiz' | 'result'>('input');
  const [questions, setQuestions] = useState<any[]>([]);
  const [answers, setAnswers] = useState<number[]>([]);
  const [result, setResult] = useState<string | null>(null);
  const isLight = theme === ThemeMode.LIGHT;

  const generateQuiz = async () => {
    if (!partnerTraits.trim() || !userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const prompt = `Act as a Relationship Astrologer. User (Male) Born: ${userProfile.dob}. He is dating someone with these traits: "${partnerTraits}".
    Generate a 5-question multi-choice quiz to determine if she is 'The One' based on his natal chart needs and her characteristics.
    Each question must have 4 options reflecting degrees of alignment.
    Return JSON: { "quiz": [{ "question": "...", "options": ["...", "...", "...", "..."] }] }`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
        config: { responseMimeType: "application/json" }
      });
      const data = JSON.parse(response.text || "{}");
      setQuestions(data.quiz || []);
      setCurrentStep('quiz');
    } catch (error) {
      alert("Failed to channel the quiz.");
    } finally {
      setLoading(false);
    }
  };

  const calculateResult = async () => {
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    const score = answers.reduce((a, b) => a + b, 0);
    
    const prompt = `Based on a compatibility score of ${score}/20 and traits: "${partnerTraits}", perform a final verdict for ${userProfile?.firstName}.
    Is she the one? Analyze her role in his life (Karmic, Soulmate, or Lesson).
    Provide:
    ### 💍 The Verdict
    ### 🌌 Spiritual Alignment
    ### ⚠️ Cosmic Warnings (if any)
    Tone: Deep, honest, and visionary.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setResult(response.text || "");
      setCurrentStep('result');
    } catch (error) {
      alert("The stars are hazy right now.");
    } finally {
      setLoading(false);
    }
  };

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-3xl font-black text-purple-500 mb-6 tracking-tight" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-violet-400 font-black" {...props} />,
    p: ({node, ...props}: any) => <p className="leading-relaxed text-lg mb-4 last:mb-0" {...props} />,
    em: ({node, ...props}: any) => <em className="text-purple-300 italic" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`flex items-center gap-2 text-xs font-black uppercase tracking-widest transition-all ${isLight ? 'text-purple-600' : 'text-purple-400'}`}>
             <i className="fa-solid fa-arrow-left"></i>
             Back to Apps
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Is She The One?</h2>
           <div className="w-20" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-venus text-5xl text-purple-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Birth Chart Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">We need your birth data to check your relationship houses before we analyze her.</p>
            <button onClick={onOpenProfile} className="relative px-10 py-4 rounded-2xl bg-gradient-to-b from-[#A855F7] via-[#7C3AED] to-[#5B21B6] hover:from-[#9333EA] hover:via-[#6D28D9] hover:to-[#4C1D95] text-white font-black uppercase tracking-widest shadow-2xl shadow-purple-500/30 transition-all overflow-hidden">
               <div className="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-white/30 to-transparent pointer-events-none opacity-40"></div>
               <span className="relative z-10">Set Up Profile</span>
            </button>
          </div>
        ) : currentStep === 'input' ? (
          <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-xl ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
            <h3 className="text-xl font-serif font-black mb-6">Tell us about her characteristics:</h3>
            <textarea 
              className={`w-full p-4 rounded-2xl border-2 outline-none mb-6 h-40 ${isLight ? 'bg-slate-50 border-purple-100' : 'bg-white/5 border-white/10 text-white'}`}
              placeholder="She is very ambitious, loves nature, but can be a bit secretive about her past..."
              value={partnerTraits}
              onChange={(e) => setPartnerTraits(e.target.value)}
            />
            <button onClick={generateQuiz} disabled={loading || !partnerTraits.trim()} className="relative w-full py-5 rounded-2xl bg-gradient-to-b from-[#A855F7] via-[#7C3AED] to-[#5B21B6] hover:from-[#9333EA] hover:via-[#6D28D9] hover:to-[#4C1D95] text-white font-black uppercase tracking-widest hover:scale-[1.02] active:scale-95 transition-all shadow-xl shadow-purple-600/30 overflow-hidden">
               <div className="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-white/30 to-transparent pointer-events-none opacity-40"></div>
               <span className="relative z-10">{loading ? 'Consulting Venus...' : 'Generate Verdict Quiz'}</span>
            </button>
          </div>
        ) : currentStep === 'quiz' ? (
          <div className="w-full max-w-xl space-y-6">
            <h3 className="text-xl font-serif font-black text-center">Step {answers.length + 1} of {questions.length}</h3>
            <div className={`p-8 rounded-[2.5rem] border-2 shadow-xl ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900 border-white/5'}`}>
              <p className="text-lg font-serif italic mb-8">{questions[answers.length]?.question}</p>
              <div className="grid gap-3">
                {questions[answers.length]?.options.map((opt: string, idx: number) => (
                  <button key={idx} onClick={() => {
                    const newAnswers = [...answers, idx + 1];
                    if (newAnswers.length === questions.length) {
                      setAnswers(newAnswers);
                      calculateResult();
                    } else {
                      setAnswers(newAnswers);
                    }
                  }} className="p-4 rounded-xl border-2 text-left hover:bg-[#7C3AED] hover:text-white transition-all text-sm font-bold shadow-sm">
                    {opt}
                  </button>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/40'}`}>
            <div className="absolute top-0 left-0 w-full h-2 bg-gradient-to-b from-[#A855F7] via-[#7C3AED] to-[#5B21B6]"></div>
            <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
              <ReactMarkdown components={markdownComponents}>{result || ""}</ReactMarkdown>
            </div>
            <button onClick={() => setCurrentStep('input')} className="mt-12 px-8 py-4 rounded-xl border-2 border-purple-500/20 text-[10px] font-black uppercase tracking-widest hover:bg-[#7C3AED] hover:text-white transition-all shadow-md">Start Over</button>
          </div>
        )}
        
        {loading && (
          <div className="fixed inset-0 z-[120] bg-black/60 backdrop-blur-sm flex flex-col items-center justify-center gap-4">
             <div className="w-12 h-12 rounded-full border-4 border-[#7C3AED] border-t-transparent animate-spin"></div>
             <p className="text-white font-serif italic">Analyzing the energetic signatures...</p>
          </div>
        )}
      </div>
    </div>
  );
};

export default IsSheTheOneApp;