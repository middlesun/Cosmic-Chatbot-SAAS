import React, { useState } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface DreamInterpreterAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const DreamInterpreterApp: React.FC<DreamInterpreterAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [dreamLog, setDreamLog] = useState("");
  const [interpretation, setInterpretation] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const interpretDream = async () => {
    if (!dreamLog.trim()) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const context = userProfile ? `User Profile: Sex ${userProfile.sex}, Born ${userProfile.dob} at ${userProfile.tob}.` : "No profile provided.";
    const prompt = `${context}
    The user experienced this dream: "${dreamLog}".
    1. Identify recurring symbols and their archetypal meanings.
    2. Link these symbols to likely natal chart placements (e.g., 'Your Neptune square Moon might be causing these tsunami dreams').
    3. Suggest practical remedies (rituals, sleep hygiene, or mindset shifts).
    IMPORTANT: Use Headers (###) for sections. Use bold (**) for key symbols. Use italics (*) for psychological links. Use a thematic color-coding description.
    Tone: Analytical, empathetic, and Jungian-Astrological.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setInterpretation(response.text || "The subconscious remains a mystery. Try again.");
    } catch (error) {
      setInterpretation("The bridge to the dream realm is currently closed.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!interpretation) return;
    navigator.clipboard.writeText(interpretation);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-3xl font-black text-indigo-400 mb-6 mt-8 tracking-tighter" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-purple-400 font-black" {...props} />,
    em: ({node, ...props}: any) => <em className="text-indigo-300 italic" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`w-12 h-12 flex items-center justify-center rounded-full transition-all shadow-lg border-2 ${isLight ? 'bg-white border-purple-50 text-purple-600 hover:border-purple-400' : 'bg-slate-900 border-white/5 text-purple-400 hover:border-white/20'}`} title="Back to Apps">
             <i className="fa-solid fa-arrow-left text-lg"></i>
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Dream Interpreter</h2>
           <div className="w-12" />
        </div>

        <div className="w-full space-y-8">
          <div className={`p-8 rounded-[3rem] border-2 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
            <label className="text-[10px] uppercase font-black tracking-widest mb-4 block opacity-60">Log your dream details:</label>
            <textarea 
              className={`w-full p-6 rounded-3xl border-2 outline-none focus:ring-4 focus:ring-indigo-500/20 transition-all min-h-[150px] mb-6 font-serif italic text-lg ${isLight ? 'bg-slate-50 border-purple-100 text-slate-900' : 'bg-white/5 border-white/10 text-white'}`}
              placeholder="I was walking through an endless library filled with water..."
              value={dreamLog}
              onChange={(e) => setDreamLog(e.target.value)}
            />
            <button 
              disabled={loading || !dreamLog.trim()}
              onClick={interpretDream}
              className="w-full py-5 rounded-2xl bg-gradient-to-tr from-indigo-600 to-slate-900 text-white text-[11px] font-black uppercase tracking-[0.4em] shadow-xl hover:scale-[1.02] active:scale-95 transition-all disabled:opacity-30"
            >
              {loading ? 'Analyzing Subconscious Patterns...' : 'Interpret My Dream'}
            </button>
          </div>

          {interpretation && !loading && (
            <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden animate-in fade-in slide-in-from-top-4 duration-1000 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/40 border-indigo-500/10 backdrop-blur-xl'}`}>
              <div className="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-indigo-400 via-purple-500 to-slate-900"></div>
              <div className="absolute top-6 right-8">
                 <button onClick={handleCopy} className={`flex items-center gap-2 px-5 py-2.5 rounded-xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-indigo-500/20 hover:bg-indigo-600 hover:text-white'}`}>
                    <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                    {copied ? 'Copied' : 'Copy'}
                 </button>
              </div>
              <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
                <ReactMarkdown components={markdownComponents}>{interpretation}</ReactMarkdown>
              </div>
              {!userProfile && (
                <div className="mt-8 p-4 rounded-xl bg-amber-500/10 border border-amber-500/20 text-center">
                  <p className="text-[10px] uppercase font-black tracking-widest text-amber-500">Notice</p>
                  <button onClick={onOpenProfile} className="text-xs font-bold underline hover:text-amber-400">Setup Profile for Personalized Chart Links</button>
                </div>
              )}
            </div>
          )}
        </div>

        <button onClick={onBack} className={`mt-16 mb-8 px-12 py-5 rounded-2xl font-black uppercase tracking-widest transition-all shadow-xl hover:scale-105 active:scale-95 ${isLight ? 'bg-white border-2 border-purple-100 text-purple-600' : 'bg-slate-900 border-2 border-white/5 text-purple-400'}`}>
          <i className="fa-solid fa-arrow-left mr-3"></i>
          Back to Apps
        </button>
      </div>
    </div>
  );
};

export default DreamInterpreterApp;