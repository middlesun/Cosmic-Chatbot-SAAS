import React, { useState } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface ManifestorAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const ManifestorApp: React.FC<ManifestorAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [goal, setGoal] = useState("");
  const [plan, setPlan] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const generatePlan = async () => {
    if (!userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const prompt = `User: ${userProfile.firstName}, Born ${userProfile.dob}.
    Manifestation Goal: "${goal}".
    Create a detailed 30-day manifestation plan aligned with their chart’s Jupiter (expansion) and Moon (emotions).
    Include:
    - Weekly focus areas
    - Specific Moon Phase timing for rituals
    - Personalized mantras
    - "Obstacle-Busting" rituals based on their likely Saturn placements.
    IMPORTANT: Use Headers (###) for sections. Use bold (**) for dates and ritual actions. Use italics (*) for the energetic 'why'. 
    Tone: Empowering, practical, and highly mystical. Use Markdown tables for the 30-day schedule.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setPlan(response.text || "The manifestation field is currently unstable. Try again.");
    } catch (error) {
      setPlan("Planetary alignment failed. Please re-enter the manifest field.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!plan) return;
    navigator.clipboard.writeText(plan);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-3xl font-black text-rose-500 mb-10 mt-16 tracking-tighter" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-pink-400 font-black" {...props} />,
    em: ({node, ...props}: any) => <em className="text-rose-400 italic" {...props} />,
    table: ({node, ...props}: any) => <table className="w-full border-collapse mb-10" {...props} />,
    th: ({node, ...props}: any) => <th className="bg-rose-500/20 text-rose-500 p-4 font-black uppercase text-xs tracking-widest text-left" {...props} />,
    td: ({node, ...props}: any) => <td className="p-4 border-b border-white/10" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-5xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`w-12 h-12 flex items-center justify-center rounded-full transition-all shadow-lg border-2 ${isLight ? 'bg-white border-purple-50 text-purple-600 hover:border-purple-400' : 'bg-slate-900 border-white/5 text-purple-400 hover:border-white/20'}`} title="Back to Apps">
             <i className="fa-solid fa-arrow-left text-lg"></i>
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">AI Manifestor</h2>
           <div className="w-12" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-wand-sparkles text-5xl text-rose-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Lunar Rhythm Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">We need your moon placement to align your manifestation with your emotional tide.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-rose-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-pink-500/20">Set Up Profile</button>
          </div>
        ) : (
          <div className="w-full space-y-12">
            <div className={`p-8 md:p-12 rounded-[3rem] border-2 shadow-xl ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
              <div className="text-center mb-8">
                 <h3 className="text-xl font-serif font-black mb-2">What is your heart's greatest desire?</h3>
                 <p className="text-xs opacity-50 uppercase tracking-[0.2em]">Be as specific as possible for the AI Oracle</p>
              </div>
              <input 
                className={`w-full p-6 rounded-3xl border-2 outline-none focus:ring-4 focus:ring-rose-500/20 transition-all text-xl font-serif italic mb-8 text-center ${isLight ? 'bg-slate-50 border-purple-100 text-slate-900' : 'bg-white/5 border-white/10 text-white'}`}
                placeholder="I manifest a prosperous new home in a quiet coastal town..."
                value={goal}
                onChange={(e) => setGoal(e.target.value)}
              />
              <button 
                disabled={loading || !goal.trim()}
                onClick={generatePlan}
                className="w-full py-6 rounded-3xl bg-gradient-to-tr from-rose-500 to-pink-600 text-white text-[12px] font-black uppercase tracking-[0.5em] shadow-2xl hover:scale-[1.02] active:scale-95 transition-all disabled:opacity-30"
              >
                {loading ? 'Weaving the Reality Matrix...' : 'Generate 30-Day Path'}
              </button>
            </div>

            {plan && !loading && (
              <div className={`w-full p-8 md:p-16 rounded-[4rem] border-2 shadow-2xl relative overflow-hidden animate-in zoom-in-95 duration-1000 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/40 border-rose-500/10 backdrop-blur-2xl'}`}>
                <div className="absolute top-0 left-0 w-full h-3 bg-gradient-to-r from-rose-400 via-pink-500 to-purple-600"></div>
                <div className="absolute top-8 right-12">
                   <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-rose-500/20 hover:bg-rose-600 hover:text-white'}`}>
                      <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                      {copied ? 'Plan Copied' : 'Copy Full Plan'}
                   </button>
                </div>
                <div className={`prose prose-xl max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
                  <ReactMarkdown components={markdownComponents}>{plan}</ReactMarkdown>
                </div>
              </div>
            )}
          </div>
        )}

        <button onClick={onBack} className={`mt-16 mb-8 px-12 py-5 rounded-2xl font-black uppercase tracking-widest transition-all shadow-xl hover:scale-105 active:scale-95 ${isLight ? 'bg-white border-2 border-purple-100 text-purple-600' : 'bg-slate-900 border-2 border-white/5 text-purple-400'}`}>
          <i className="fa-solid fa-arrow-left mr-3"></i>
          Back to Apps
        </button>
      </div>
    </div>
  );
};

export default ManifestorApp;