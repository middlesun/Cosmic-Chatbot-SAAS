import React, { useState, useEffect } from 'react';
import ReactMarkdown from 'react-markdown';
import { Message, FontSize, FontType, ThemeMode } from '../types';
import { FONT_SIZE_MAP } from '../constants';

interface ChatBubbleProps {
  message: Message;
  fontSize: FontSize;
  fontType: FontType;
  onStar: (id: string) => void;
  onCopy: (content: string) => void;
  onSuggestedClick: (question: string) => void;
  theme?: ThemeMode;
}

const ChatBubble: React.FC<ChatBubbleProps> = ({ 
  message, 
  fontSize, 
  fontType, 
  onStar, 
  onCopy,
  onSuggestedClick,
  theme
}) => {
  const isAssistant = message.role === 'assistant';
  const isLight = theme === ThemeMode.LIGHT;
  
  const [showCopyFeedback, setShowCopyFeedback] = useState(false);
  const [showSaveFeedback, setShowSaveFeedback] = useState(false);

  if (isAssistant && !message.content) return null;

  const stripMarkdown = (text: string) => {
    return text
      .replace(/(\*\*|__)(.*?)\1/g, '$2') 
      .replace(/(\*|_)(.*?)\1/g, '$2') 
      .replace(/\[(.*?)\]\(.*?\)/g, '$1') 
      .replace(/(^|\n)#+\s+(.*)/g, '$1$2') 
      .replace(/`{1,3}.*?`{1,3}/g, '') 
      .trim();
  };

  const formatContent = (content: string) => {
    const parts = content.split('[FOLLOWUP]');
    const mainText = parts[0];
    const suggestedText = parts[1] || "";
    
    const rawQuestions = suggestedText
      .split(/\r?\n/)
      .map(q => q.trim())
      .filter(q => q.length > 0);

    const questions = rawQuestions.map((q, index) => {
        const cleanQ = q.replace(/^\d+[\.\)]\s*/, '');
        return {
            text: cleanQ,
            display: `${index + 1}. ${cleanQ}`
        };
    });

    return { mainText, questions };
  };

  const { mainText, questions } = formatContent(message.content);

  const handleCopy = () => {
    const plainText = stripMarkdown(mainText);
    onCopy(plainText);
    setShowCopyFeedback(true);
  };

  const handleStar = () => {
    onStar(message.id);
    if (!message.isStarred) {
      setShowSaveFeedback(true);
    }
  };

  useEffect(() => {
    if (showCopyFeedback) {
      const timer = setTimeout(() => setShowCopyFeedback(false), 2000);
      return () => clearTimeout(timer);
    }
  }, [showCopyFeedback]);

  useEffect(() => {
    if (showSaveFeedback) {
      const timer = setTimeout(() => setShowSaveFeedback(false), 2000);
      return () => clearTimeout(timer);
    }
  }, [showSaveFeedback]);

  // Vibrant custom components for Multi-color output - STANDARDIZED FONT SIZES
  const markdownComponents = {
    h1: ({node, ...props}: any) => <h1 className="text-base sm:text-lg font-black text-rose-500 mb-2 tracking-tighter inline-block" {...props} />,
    h2: ({node, ...props}: any) => <h2 className="text-base sm:text-lg font-black text-pink-500 mb-2 tracking-tight inline-block" {...props} />,
    h3: ({node, ...props}: any) => <h3 className="text-base sm:text-lg font-black text-fuchsia-500 mb-1 inline-block" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-indigo-400 font-black" {...props} />,
    em: ({node, ...props}: any) => <em className="text-amber-400 not-italic font-bold underline decoration-amber-500/30" {...props} />,
    li: ({node, ...props}: any) => <li className="mb-2 list-disc ml-4 text-inherit" {...props} />,
    p: ({node, ...props}: any) => <p className="mb-2 last:mb-0 leading-relaxed" {...props} />,
  };

  return (
    <div className={`flex w-full mb-4 sm:mb-8 ${isAssistant ? 'justify-start' : 'justify-end'} group animate-in fade-in duration-500`}>
      <div className={`flex items-start gap-2 max-w-[95%] sm:max-w-[85%] ${isAssistant ? 'flex-row' : 'flex-row-reverse'}`}>
        <div className={`flex-1 relative ${isAssistant ? '' : 'text-right'}`}>
          {message.images && message.images.length > 0 && (
            <div className={`flex flex-wrap gap-2 mb-3 ${isAssistant ? 'justify-start' : 'justify-end'}`}>
              {message.images.map((img, idx) => (
                <div key={idx} className="relative group/img overflow-hidden rounded-2xl border border-white/5 shadow-lg">
                   <img src={img} alt="Uploaded" className="w-32 h-32 sm:w-48 sm:h-48 object-cover transition-transform duration-500 group-hover/img:scale-105" />
                </div>
              ))}
            </div>
          )}

          <div 
            className={`p-4 sm:p-6 rounded-[1.8rem] transition-all relative shadow-xl ${
              isAssistant 
                ? `rounded-tl-none border-white/5 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/80 backdrop-blur-md'}` 
                : `rounded-tr-none bg-gradient-to-tr from-purple-600 to-indigo-700 text-white`
            }`}
            style={{ fontFamily: fontType }}
          >
            <div className={`whitespace-pre-wrap text-left leading-relaxed prose prose-base max-w-none ${
              !isAssistant ? 'text-white prose-invert' : (isLight ? 'text-slate-900 prose-slate' : 'text-slate-100 prose-invert')
            } ${FONT_SIZE_MAP[fontSize]}`}>
              <ReactMarkdown components={isAssistant ? markdownComponents : undefined}>{mainText}</ReactMarkdown>
            </div>
            
            <div className="flex gap-3 mt-4 opacity-40 group-hover:opacity-100 transition-opacity justify-end">
              <button onClick={handleStar} className={`p-1.5 hover:bg-black/5 rounded-lg transition-colors ${message.isStarred ? 'text-yellow-400 opacity-100' : (isAssistant ? '' : 'text-white')}`}>
                <i className={`fa-solid fa-star text-xs`}></i>
              </button>
              <button onClick={handleCopy} className={`p-1.5 hover:bg-black/5 rounded-lg transition-colors ${isAssistant ? '' : 'text-white'}`}>
                <i className="fa-solid fa-copy text-xs"></i>
              </button>
            </div>
          </div>

          {isAssistant && questions.length > 0 && (
            <div className="mt-4 flex flex-col gap-2 max-w-full">
              {questions.map((q, idx) => (
                <button
                  key={idx}
                  onClick={() => onSuggestedClick(q.text)}
                  className={`px-5 py-3 rounded-2xl text-xs font-bold transition-all text-left w-fit max-w-full hover:bg-purple-600 hover:text-white shadow-md border ${
                    isLight 
                    ? 'bg-white text-purple-800 border-purple-50' 
                    : 'bg-slate-900/40 text-purple-200 border-white/5'
                  }`}
                >
                   {q.text}
                </button>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

export default ChatBubble;