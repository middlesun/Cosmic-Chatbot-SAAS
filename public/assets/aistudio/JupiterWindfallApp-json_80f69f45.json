
import React, { useState, useEffect } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface JupiterWindfallAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const JupiterWindfallApp: React.FC<JupiterWindfallAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [windows, setWindows] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const generateWindows = async () => {
    if (!userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const now = new Date();
    const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });

    const prompt = `Generate a list of "Jupiter Windfall Windows" for ${userProfile.firstName} STARTING FROM TODAY: ${dateStr}, ${timeStr}.
    Details: Born ${userProfile.dob} at ${userProfile.tob}.
    Task: Calculate specific periods for the next 12 months starting from today when transit Jupiter forms favorable aspects (conjunction, trine, sextile) to their natal 2nd house cusp, 8th house cusp, or rulers of these houses.
    Include:
    - Exact Date Windows
    - Type of Opportunity (e.g., 'Inheritance luck', 'Career bonus', 'Investments').
    - Rationale based on the specific degree of Jupiter.
    IMPORTANT: Use Headers (###). Use bold (**) for date ranges. Highlight 'Peak Abundance' vs 'Expansion'.
    Tone: Majestic, promising, and precise. Use the provided date as the actual today and ignore internal knowledge cutoffs.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setWindows(response.text || "Jupiter is currently resting. No windfalls seen yet.");
    } catch (error) {
      setWindows("The abundance oracle is currently hazy.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!windows) return;
    navigator.clipboard.writeText(windows);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  useEffect(() => {
    if (userProfile) generateWindows();
  }, [userProfile]);

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-4xl font-black text-amber-500 uppercase mb-10 mt-16 tracking-tighter" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-yellow-400 font-black text-3xl" {...props} />,
    p: ({node, ...props}: any) => <p className="leading-relaxed font-serif italic text-xl mb-4 last:mb-0" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center text-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`flex items-center gap-2 text-xs font-black uppercase tracking-widest transition-all ${isLight ? 'text-amber-600' : 'text-amber-400'}`}>
             <i className="fa-solid fa-arrow-left"></i>
             Back to Apps
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter text-amber-500">Jupiter Windfall</h2>
           <div className="w-20" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-amber-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-coins text-5xl text-amber-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Chart Identity Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">We need your birth degrees to pinpoint Jupiter's exact bounty windows.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-amber-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-amber-500/20">Set Up Profile</button>
          </div>
        ) : loading ? (
          <div className="flex flex-col items-center justify-center p-20 gap-6">
            <div className="w-24 h-24 relative flex items-center justify-center">
               <div className="absolute inset-0 rounded-full border-4 border-amber-500/20 border-t-amber-500 animate-spin"></div>
               <i className="fa-solid fa-coins text-3xl text-amber-500 animate-pulse"></i>
            </div>
            <p className="text-xl font-serif italic animate-pulse text-amber-400">Scanning the orbital path of abundance...</p>
          </div>
        ) : (
          <div className={`w-full p-8 md:p-16 rounded-[4rem] border-4 shadow-2xl relative overflow-hidden text-left transition-all duration-1000 ${
            isLight ? 'bg-white border-amber-100' : 'bg-slate-950 border-amber-500/20'
          }`}>
            <div className="absolute top-0 left-0 w-full h-4 bg-gradient-to-r from-amber-400 via-orange-500 to-yellow-600"></div>
            <div className="absolute top-8 right-12">
               <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-amber-500/20 hover:bg-amber-600 hover:text-white'}`}>
                  <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                  {copied ? 'Windows Saved' : 'Copy Windows'}
               </button>
            </div>
            <div className={`prose prose-xl max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
              <ReactMarkdown components={markdownComponents}>{windows || ""}</ReactMarkdown>
            </div>
            <div className="mt-16 p-8 rounded-3xl bg-amber-500/5 border-2 border-amber-500/20 text-center">
              <p className="text-[10px] font-black uppercase tracking-[0.4em] text-amber-500 mb-4">Expansion Protocol Active</p>
              <button onClick={generateWindows} className="px-12 py-4 rounded-2xl bg-amber-600 text-white text-[11px] font-black uppercase tracking-widest hover:bg-amber-700 transition-all shadow-xl shadow-amber-500/30">Refresh Abundance Windows</button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default JupiterWindfallApp;
