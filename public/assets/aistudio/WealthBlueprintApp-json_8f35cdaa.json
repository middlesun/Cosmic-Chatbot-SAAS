
import React, { useState, useEffect } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface WealthBlueprintAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const WealthBlueprintApp: React.FC<WealthBlueprintAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [blueprint, setBlueprint] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const generateBlueprint = async () => {
    if (!userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const now = new Date();
    const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });

    const prompt = `Analyze the "Financial DNA" and "Wealth Blueprint" for ${userProfile.firstName} AS OF TODAY: ${dateStr}, ${timeStr}.
    Birth Context: Sex ${userProfile.sex}, Born ${userProfile.dob} at ${userProfile.tob || 'Unknown'}.
    
    Predictive Objectives:
    1. Identify their "Financial Archetype" (e.g., The Accumulator, The Visionary, The Alchemist) based on 2nd House and 11th House placements.
    2. Deep Dive: Analyze Jupiter's natal house and how its current transit (today's actual position) expands their resource sector.
    3. Industry Matchmaking: Suggest 3 specific high-growth industries aligned with their 10th House/MC and today's cosmic vibe.
    4. Wealth Timeline: Identify the "Peak Abundance Years" based on Saturn cycles.
    
    Structure:
    ### 🔱 Your Wealth Archetype: [Archetype Name]
    ### 💎 The 2nd House Treasury
    (In-depth analysis of how you attract money)
    ### 🚀 Scalability & Networking (11th House)
    (How to leverage community for wealth)
    ### 📈 Strategic Side-Gigs
    (3 tailored Earth/Air/Fire/Water suggestions)
    ### ⚠️ Karmic Leakage
    (Blind spots and how to fix them)

    IMPORTANT: Use Headers (###). Use bold (**) for specific industries and dates. Use italics (*) for the strategic reasoning.
    Tone: Ambitious, practical, and luxurious. Ignore training data cutoff dates; use the provided date as actual today.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setBlueprint(response.text || "The treasury is currently locked. Try again later.");
    } catch (error) {
      setBlueprint("Financial planetary alignment failed.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!blueprint) return;
    navigator.clipboard.writeText(blueprint);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  useEffect(() => {
    if (userProfile) generateBlueprint();
  }, [userProfile]);

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-2xl font-black text-emerald-500 mb-10 mt-12 tracking-tighter" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-green-400 font-black text-xl" {...props} />,
    p: ({node, ...props}: any) => <p className="leading-relaxed text-lg mb-4 last:mb-0" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`flex items-center gap-2 text-xs font-black uppercase tracking-widest transition-all ${isLight ? 'text-emerald-600' : 'text-emerald-400'}`}>
             <i className="fa-solid fa-arrow-left"></i>
             Back to Apps
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter text-emerald-500">Wealth Blueprint</h2>
           <div className="w-20" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-emerald-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-vault text-5xl text-emerald-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Treasury ID Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">We need your birth chart to unlock your unique wealth-attraction signature.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-emerald-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-emerald-500/20">Set Up Profile</button>
          </div>
        ) : loading ? (
          <div className="flex flex-col items-center justify-center p-20 gap-6">
            <div className="w-16 h-16 rounded-full border-4 border-emerald-500 border-t-transparent animate-spin"></div>
            <p className="text-lg font-serif italic animate-pulse text-emerald-400">Scanning the 2nd House archives...</p>
          </div>
        ) : (
          <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden transition-all duration-500 ${
            isLight ? 'bg-white border-emerald-50' : 'bg-slate-900/40 border-emerald-500/10 backdrop-blur-xl'
          }`}>
            <div className="absolute top-0 left-0 w-full h-3 bg-gradient-to-r from-emerald-400 via-green-500 to-teal-600"></div>
            <div className="absolute top-6 right-8">
               <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-emerald-500/20 hover:bg-emerald-600 hover:text-white'}`}>
                  <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                  {copied ? 'Blueprint Copied' : 'Copy Strategy'}
               </button>
            </div>
            <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
              <ReactMarkdown components={markdownComponents}>{blueprint || ""}</ReactMarkdown>
            </div>
            <button onClick={generateBlueprint} className="mt-12 px-8 py-4 rounded-2xl border-2 border-emerald-500/20 text-[10px] font-black uppercase tracking-widest hover:bg-emerald-600 hover:text-white transition-all shadow-lg">Recalculate Wealth Path</button>
          </div>
        )}
      </div>
    </div>
  );
};

export default WealthBlueprintApp;
