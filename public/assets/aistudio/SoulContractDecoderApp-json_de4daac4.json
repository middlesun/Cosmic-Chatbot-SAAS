
import React, { useState } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface SoulContractDecoderAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const SoulContractDecoderApp: React.FC<SoulContractDecoderAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [partnerName, setPartnerName] = useState("");
  const [partnerDob, setPartnerDob] = useState("");
  const [report, setReport] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const decodeContract = async () => {
    if (!partnerDob || !userProfile) return;
    setLoading(true);
    // Initialize GoogleGenAI right before making an API call to ensure it uses up-to-date key
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const prompt = `Decode the "Soul Contract" between:
    Person A (User): ${userProfile.firstName}, Born ${userProfile.dob}.
    Person B (Partner): ${partnerName}, Born ${partnerDob}.
    Analyze:
    1. Past Life Connection: Probable history based on Ketu (South Node) and 12th house overlays.
    2. The Contract Agreement: What did these two souls agree to teach each other in this lifetime? (e.g., 'You agreed to teach each other trust in the 1500s').
    3. Current Mission: The specific karmic goal of this relationship today.
    IMPORTANT: Use Headers (###). Use bold (**) for specific past-life eras or roles. Use italic (*) for soul lessons.
    Tone: Mythical, deep, and incredibly profound.`;

    try {
      // Use gemini-3-flash-preview for text analysis tasks
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      // Correct access of generated text output via .text property
      setReport(response.text || "The archives of the soul are locked.");
    } catch (error) {
      console.error("Soul Contract Error:", error);
      setReport("Failed to retrieve the akashic contract.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!report) return;
    navigator.clipboard.writeText(report);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-4xl font-black text-amber-500 uppercase mb-10 mt-16 tracking-tighter" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-orange-400 underline decoration-amber-500/20 font-black" {...props} />,
    p: ({node, ...props}: any) => <p className="leading-relaxed font-serif italic mb-4 last:mb-0" {...props} />,
    em: ({node, ...props}: any) => <em className="text-amber-300 not-italic font-bold" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`w-12 h-12 flex items-center justify-center rounded-full transition-all shadow-lg border-2 ${isLight ? 'bg-white border-purple-50 text-purple-600 hover:border-purple-400' : 'bg-slate-900 border-white/5 text-purple-400 hover:border-white/20'}`} title="Back to Apps">
             <i className="fa-solid fa-arrow-left text-lg"></i>
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Soul Contract Decoder</h2>
           <div className="w-12" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-file-contract text-5xl text-amber-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Celestial Archive Access Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">We need your birth data to identify your soul's prior agreements in the akashic registry.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-amber-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-amber-500/20">Set Up Profile</button>
          </div>
        ) : (
          <div className="w-full space-y-8">
            <div className={`p-8 rounded-[3rem] border-2 shadow-xl ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
                <div>
                  <label className="text-[10px] uppercase font-black tracking-widest mb-1 block opacity-60">Partner's Name</label>
                  <input type="text" className={`w-full p-3 rounded-xl border outline-none ${isLight ? 'bg-white border-slate-200' : 'bg-white/5 border-white/10 text-white'}`} value={partnerName} onChange={e => setPartnerName(e.target.value)} placeholder="Enter name..." />
                </div>
                <div>
                  <label className="text-[10px] uppercase font-black tracking-widest mb-1 block opacity-60">Partner's Birth Date</label>
                  <input type="date" className={`w-full p-3 rounded-xl border outline-none ${isLight ? 'bg-white border-slate-200' : 'bg-white/5 border-white/10 text-white'}`} value={partnerDob} onChange={e => setPartnerDob(e.target.value)} />
                </div>
              </div>
              <button 
                disabled={loading || !partnerDob}
                onClick={decodeContract}
                className="w-full py-5 rounded-2xl bg-gradient-to-tr from-amber-600 to-orange-800 text-white text-[11px] font-black uppercase tracking-[0.4em] shadow-xl hover:scale-[1.02] active:scale-95 transition-all disabled:opacity-30"
              >
                {loading ? 'Accessing the Akashic Records...' : 'Decode Soul Contract'}
              </button>
            </div>

            {report && !loading && (
              <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden animate-in fade-in slide-in-from-top-4 duration-1000 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/40 border-amber-500/10 backdrop-blur-xl'}`}>
                <div className="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-amber-400 via-orange-500 to-orange-800"></div>
                <div className="absolute top-6 right-8">
                   <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-amber-500/20 hover:bg-amber-600 hover:text-white'}`}>
                      <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                      {copied ? 'Contract Copied' : 'Copy Contract'}
                   </button>
                </div>
                <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
                  <ReactMarkdown components={markdownComponents}>{report}</ReactMarkdown>
                </div>
              </div>
            )}
          </div>
        )}

        <button onClick={onBack} className={`mt-16 mb-8 px-12 py-5 rounded-2xl font-black uppercase tracking-widest transition-all shadow-xl hover:scale-105 active:scale-95 ${isLight ? 'bg-white border-2 border-purple-100 text-purple-600' : 'bg-slate-900 border-2 border-white/5 text-purple-400'}`}>
          <i className="fa-solid fa-arrow-left mr-3"></i>
          Back to Apps
        </button>
      </div>
    </div>
  );
};

// Fix: Added missing default export
export default SoulContractDecoderApp;
