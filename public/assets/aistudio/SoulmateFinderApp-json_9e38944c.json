import React, { useState, useEffect } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface SoulmateFinderAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const SoulmateFinderApp: React.FC<SoulmateFinderAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [report, setReport] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const findSoulmate = async () => {
    if (!userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const prompt = `Generate a "Soulmate Attraction Report" for ${userProfile.firstName}.
    Birth Info: Born ${userProfile.dob} at ${userProfile.tob}.
    Using their 7th house (partnership), Venus (love), and Jupiter (growth):
    1. Best Ways to Attract: Behavioral and energetic shifts.
    2. Timings: Windows of opportunity when soulmate energy is highest.
    3. What to Expect: Archetypal traits of their likely soulmate.
    IMPORTANT: Use Headers (###). Use bold (**) for key personality traits. Use italics (*) for spiritual guidance.
    Tone: Deeply mystical, hopeful, and accurate.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setReport(response.text || "The twin flame is flickering out. Try again.");
    } catch (error) {
      setReport("The soul connection failed to initiate.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!report) return;
    navigator.clipboard.writeText(report);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  useEffect(() => {
    if (userProfile) findSoulmate();
  }, [userProfile]);

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-3xl font-black text-purple-500 mb-8 mt-10" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-violet-400 font-black" {...props} />,
    p: ({node, ...props}: any) => <p className="leading-relaxed mb-4 last:mb-0" {...props} />,
    em: ({node, ...props}: any) => <em className="text-purple-300 italic" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`w-12 h-12 flex items-center justify-center rounded-full transition-all shadow-lg border-2 ${isLight ? 'bg-white border-purple-50 text-purple-600 hover:border-purple-400' : 'bg-slate-900 border-white/5 text-purple-400 hover:border-white/20'}`} title="Back to Apps">
             <i className="fa-solid fa-arrow-left text-lg"></i>
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Soulmate Finder</h2>
           <div className="w-12" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-magnifying-glass-heart text-5xl text-purple-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Contract Data Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">To find your soulmate in the stars, we need your birth details.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-purple-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-purple-500/20">Set Up Profile</button>
          </div>
        ) : loading ? (
          <div className="flex flex-col items-center justify-center p-20 gap-6">
            <div className="w-16 h-16 rounded-full border-4 border-purple-500 border-t-transparent animate-spin"></div>
            <p className="text-lg font-serif italic animate-pulse text-purple-400">Scanning soul contracts across lifetimes...</p>
          </div>
        ) : (
          <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden transition-all duration-500 ${
            isLight ? 'bg-white border-purple-50' : 'bg-slate-900/40 border-purple-500/10 backdrop-blur-xl'
          }`}>
            <div className="absolute top-0 left-0 w-full h-3 bg-gradient-to-r from-purple-400 to-indigo-600"></div>
            <div className={`prose prose-lg max-not-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
              <ReactMarkdown components={markdownComponents}>{report || ""}</ReactMarkdown>
            </div>
            <div className="mt-12 flex flex-wrap gap-4 items-center">
              <button onClick={findSoulmate} className="px-8 py-4 rounded-2xl border-2 border-purple-500/20 text-[10px] font-black uppercase tracking-widest hover:bg-purple-600 hover:text-white transition-all shadow-lg">Search Again</button>
              <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-purple-500/20 hover:bg-purple-600 hover:text-white'}`}>
                <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                {copied ? 'Copied' : 'Copy Attraction Report'}
              </button>
            </div>
          </div>
        )}

        <button onClick={onBack} className={`mt-16 mb-8 px-12 py-5 rounded-2xl font-black uppercase tracking-widest transition-all shadow-xl hover:scale-105 active:scale-95 ${isLight ? 'bg-white border-2 border-purple-100 text-purple-600' : 'bg-slate-900 border-2 border-white/5 text-purple-400'}`}>
          <i className="fa-solid fa-arrow-left mr-3"></i>
          Back to Apps
        </button>
      </div>
    </div>
  );
};

export default SoulmateFinderApp;