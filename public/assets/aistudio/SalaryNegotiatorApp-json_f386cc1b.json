
import React, { useState } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface SalaryNegotiatorAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const SalaryNegotiatorApp: React.FC<SalaryNegotiatorAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [jobOffer, setJobOffer] = useState("");
  const [scripts, setScripts] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const generateScripts = async () => {
    if (!jobOffer.trim() || !userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const now = new Date();
    const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });

    const prompt = `Generate a "Salary Negotiation Script" for ${userProfile.firstName} BASED ON TODAY: ${dateStr}, ${timeStr}.
    User Born: ${userProfile.dob}.
    Current Job Offer Details: "${jobOffer}".
    Task:
    1. Negotiation Script: Provide 3 tiered response scripts (The Confident, The Analytical, The Collaborative).
    2. Timing Protocol: Based on Mercury (communication) and Jupiter (expansion) transits as of today's date, tell them when to send the email or have the talk.
    3. Cosmic Leverage: Explain which house (e.g., 2nd or 6th) they should draw energy from during the talk.
    IMPORTANT: Use Headers (###). Use code blocks (\` \`) for the actual scripts. Use bold (**) for the dates.
    Tone: Tactical, empowering, and highly effective. Ignore any model knowledge cutoffs; the provided date is today.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setScripts(response.text || "Mercury is currently retrograde. Reconsider the script later.");
    } catch (error) {
      setScripts("Negotiation oracle connection failed.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!scripts) return;
    navigator.clipboard.writeText(scripts);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-4xl font-black text-cyan-500 mb-10 mt-12 tracking-tighter" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-blue-400 font-black text-2xl" {...props} />,
    code: ({node, ...props}: any) => <code className="text-indigo-400 bg-indigo-500/5 px-6 py-4 rounded-2xl block border border-indigo-500/20 font-mono text-base leading-relaxed mb-6" {...props} />,
    p: ({node, ...props}: any) => <p className="leading-relaxed font-serif italic text-xl mb-4 last:mb-0" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`flex items-center gap-2 text-xs font-black uppercase tracking-widest transition-all ${isLight ? 'text-cyan-600' : 'text-cyan-400'}`}>
             <i className="fa-solid fa-arrow-left"></i>
             Back to Apps
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter text-cyan-500">Salary Negotiator</h2>
           <div className="w-20" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-cyan-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-handshake-angle text-5xl text-cyan-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Career ID Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">We need your Mercury data to craft scripts that resonate with your natural voice.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-cyan-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-cyan-500/20">Set Up Profile</button>
          </div>
        ) : (
          <div className="w-full space-y-8">
            <div className={`p-8 rounded-[3rem] border-2 shadow-xl ${isLight ? 'bg-white border-cyan-50' : 'bg-slate-900/60 border-white/5'}`}>
              <label className="text-[10px] uppercase font-black tracking-widest mb-4 block opacity-60">Paste your job offer or negotiation goal:</label>
              <textarea 
                className={`w-full p-4 rounded-2xl border-2 outline-none focus:ring-4 focus:ring-cyan-500/20 transition-all min-h-[120px] mb-6 font-serif italic text-lg ${isLight ? 'bg-slate-50 border-cyan-100 text-slate-900' : 'bg-white/5 border-white/10 text-white'}`}
                placeholder="Example: Senior UX Designer role at a fintech startup, offered $120k but seeking $140k..."
                value={jobOffer}
                onChange={(e) => setJobOffer(e.target.value)}
              />
              <button 
                disabled={loading || !jobOffer.trim()}
                onClick={generateScripts}
                className="w-full py-5 rounded-2xl bg-gradient-to-tr from-cyan-500 to-blue-700 text-white text-[11px] font-black uppercase tracking-[0.4em] shadow-xl hover:scale-[1.02] active:scale-95 transition-all disabled:opacity-30"
              >
                {loading ? 'Consulting Mercury & Jupiter...' : 'Generate Negotiation Scripts'}
              </button>
            </div>

            {scripts && !loading && (
              <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden animate-in fade-in slide-in-from-top-4 duration-1000 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/40 border-cyan-500/10 backdrop-blur-xl'}`}>
                <div className="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-700"></div>
                <div className="absolute top-6 right-8">
                   <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-cyan-500/20 hover:bg-cyan-600 hover:text-white'}`}>
                      <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                      {copied ? 'Scripts Copied' : 'Copy Scripts'}
                   </button>
                </div>
                <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
                  <ReactMarkdown components={markdownComponents}>{scripts}</ReactMarkdown>
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
};

export default SalaryNegotiatorApp;
