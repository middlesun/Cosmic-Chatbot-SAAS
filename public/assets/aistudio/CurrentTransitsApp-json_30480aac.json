
import React, { useState, useEffect } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface CurrentTransitsAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const CurrentTransitsApp: React.FC<CurrentTransitsAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [report, setReport] = useState<string | null>(null);
  const isLight = theme === ThemeMode.LIGHT;

  const fetchTransits = async () => {
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const now = new Date();
    const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });

    const context = userProfile ? `User Born: ${userProfile.dob} at ${userProfile.tob || 'Unknown'}.` : "No user profile provided.";
    const prompt = `Generate a technical "Current Planetary Transits" report FOR TODAY: ${dateStr}, ${timeStr}.
    Context: ${context}.
    
    Objectives:
    1. List current degrees and signs for Sun, Moon, Mercury, Venus, Mars, Jupiter, Saturn, Rahu, Ketu, and Pluto as of this exact time.
    2. Analyze major current planetary aspects (e.g., conjunctions, squares, trines).
    3. (If profile provided) Explain how these transits are hitting the user's 1st, 10th, and 7th houses today.
    4. Provide a "Cosmic Weather" summary (Stormy, Sunny, Foggy, etc.).
    
    Format:
    - Use a Markdown table for planetary degrees.
    - Use Headers (###) for sections.
    - Use Bold (**) for high-intensity transits.
    
    Tone: Objective, informative, and predictive. Ignore any training cutoff dates; the provided date is today.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setReport(response.text || "");
    } catch (error) {
      setReport("The cosmic signal is weak today.");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchTransits();
  }, [userProfile]);

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`flex items-center gap-2 text-xs font-black uppercase tracking-widest transition-all ${isLight ? 'text-cyan-600' : 'text-cyan-400'}`}>
             <i className="fa-solid fa-arrow-left"></i>
             Back to Apps
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Current Transits</h2>
           <div className="w-20" />
        </div>

        {loading ? (
          <div className="flex flex-col items-center justify-center p-20 gap-6">
            <div className="w-16 h-16 rounded-full border-4 border-cyan-500 border-t-transparent animate-spin"></div>
            <p className="text-lg font-serif italic animate-pulse">Mapping the current sky...</p>
          </div>
        ) : (
          <div className={`w-full space-y-8`}>
            <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden transition-all duration-500 ${isLight ? 'bg-white border-cyan-50' : 'bg-slate-900/40 border-cyan-500/10 backdrop-blur-xl'}`}>
              <div className="absolute top-0 left-0 w-full h-3 bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-600"></div>
              
              {!userProfile && (
                <div className="mb-10 p-6 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-between gap-4">
                   <div className="flex items-center gap-4">
                      <i className="fa-solid fa-circle-info text-amber-500 text-xl"></i>
                      <p className="text-xs font-bold leading-relaxed">Generic report shown. Link your birth chart to see how these transits impact your personal houses.</p>
                   </div>
                   <button onClick={onOpenProfile} className="px-6 py-2 rounded-xl bg-amber-500 text-white text-[10px] font-black uppercase tracking-widest whitespace-nowrap">Link Profile</button>
                </div>
              )}

              <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'} prose-h3:text-2xl prose-h3:text-cyan-500 prose-table:border-collapse prose-th:p-4 prose-th:bg-cyan-500/10 prose-td:p-4 prose-td:border-b prose-td:border-white/5`}>
                <ReactMarkdown>{report || ""}</ReactMarkdown>
              </div>
              <button onClick={fetchTransits} className="mt-12 px-8 py-4 rounded-xl border-2 border-cyan-500/20 text-[10px] font-black uppercase tracking-widest hover:bg-cyan-600 hover:text-white transition-all shadow-lg">Refresh Sky Map</button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default CurrentTransitsApp;
