import React, { useState, useEffect } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface CosmicDNATestAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const CosmicDNATestApp: React.FC<CosmicDNATestAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [dnaResult, setDnaResult] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const performTest = async () => {
    if (!userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const prompt = `Perform a spiritual "Cosmic DNA" analysis for ${userProfile.firstName}.
    Details: Born ${userProfile.dob} at ${userProfile.tob} in ${userProfile.placeOfBirth.city}.
    Analyze the 12th house, Neptune, Pluto, and Fixed Star connections (e.g., Regulus, Sirius) to determine spiritual ancestry.
    Result should include:
    - Primary Ancestry (e.g., Pleiadian, Atlantean, Martian, Lyran)
    - Spiritual Signature (traits inherited from this lineage)
    - Soul Mission
    - A summary for a "DNA Certificate" section at the end.
    IMPORTANT: Use Headers (###) for sections. Use Bold (**) for the specific starseeds or lineages. Use code blocks (\` \`) for technical planetary alignments.
    Tone: Epic, grand, and mystical.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setDnaResult(response.text || "Your spiritual lineage remains hidden in the nebula.");
    } catch (error) {
      setDnaResult("The galactic records are temporarily unreachable.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!dnaResult) return;
    navigator.clipboard.writeText(dnaResult);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  useEffect(() => {
    if (userProfile) performTest();
  }, [userProfile]);

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-3xl font-black text-emerald-500 uppercase tracking-widest mb-8 mt-12" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-cyan-400 underline decoration-emerald-500/30 font-black" {...props} />,
    code: ({node, ...props}: any) => <code className="text-emerald-400 bg-emerald-500/5 px-2 py-1 rounded font-mono" {...props} />,
    em: ({node, ...props}: any) => <em className="text-teal-400 italic" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center text-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`w-12 h-12 flex items-center justify-center rounded-full transition-all shadow-lg border-2 ${isLight ? 'bg-white border-purple-50 text-purple-600 hover:border-purple-400' : 'bg-slate-900 border-white/5 text-purple-400 hover:border-white/20'}`} title="Back to Apps">
             <i className="fa-solid fa-arrow-left text-lg"></i>
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Cosmic DNA Test</h2>
           <div className="w-12" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-dna text-5xl text-emerald-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Galactic Map Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">Your starseed heritage is written in your natal chart. Provide birth data to scan the akashic records.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-emerald-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-emerald-500/20">Set Up Profile</button>
          </div>
        ) : loading ? (
          <div className="flex flex-col items-center justify-center p-20 gap-6">
            <div className="w-24 h-24 relative flex items-center justify-center">
               <div className="absolute inset-0 rounded-full border-4 border-emerald-500/20 border-t-emerald-500 animate-spin"></div>
               <i className="fa-solid fa-dna text-3xl text-emerald-500 animate-pulse"></i>
            </div>
            <p className="text-xl font-serif italic animate-pulse">Scanning spiritual lineage through the akashic records...</p>
          </div>
        ) : (
          <div className={`w-full p-8 md:p-16 rounded-[4rem] border-4 shadow-2xl relative overflow-hidden text-left transition-all duration-1000 ${
            isLight ? 'bg-white border-emerald-100' : 'bg-slate-950 border-emerald-500/20'
          }`}>
            <div className="absolute top-0 left-0 w-full h-4 bg-gradient-to-r from-emerald-400 via-teal-500 to-cyan-600"></div>
            <div className={`prose prose-xl max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
              <ReactMarkdown components={markdownComponents}>{dnaResult || ""}</ReactMarkdown>
            </div>
            <div className="mt-16 p-8 rounded-3xl bg-gradient-to-br from-emerald-500/5 to-cyan-500/10 border-2 border-emerald-500/20 flex flex-col sm:flex-row items-center justify-between gap-6">
              <div className="flex flex-col gap-4">
                <div>
                  <p className="text-[10px] font-black uppercase tracking-[0.4em] text-emerald-500 mb-1">Authentic Spiritual Identification</p>
                  <p className="text-sm opacity-50 italic">Verified via your unique celestial timestamp</p>
                </div>
                <button onClick={handleCopy} className={`flex items-center justify-center gap-3 px-6 py-3 rounded-xl border-2 text-[10px] font-black uppercase tracking-widest transition-all w-fit ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-emerald-500/20 hover:bg-emerald-600 hover:text-white'}`}>
                  <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                  {copied ? 'Copied to Registry' : 'Copy DNA Data'}
                </button>
              </div>
              <button className="w-full sm:w-auto px-10 py-4 rounded-2xl bg-emerald-600 text-white text-[11px] font-black uppercase tracking-widest hover:scale-105 active:scale-95 transition-all shadow-xl shadow-emerald-500/30">Download Certificate</button>
            </div>
          </div>
        )}

        <button onClick={onBack} className={`mt-16 mb-8 px-12 py-5 rounded-2xl font-black uppercase tracking-widest transition-all shadow-xl hover:scale-105 active:scale-95 ${isLight ? 'bg-white border-2 border-purple-100 text-purple-600' : 'bg-slate-900 border-2 border-white/5 text-purple-400'}`}>
          <i className="fa-solid fa-arrow-left mr-3"></i>
          Back to Apps
        </button>
      </div>
    </div>
  );
};

export default CosmicDNATestApp;