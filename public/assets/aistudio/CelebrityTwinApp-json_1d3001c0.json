import React, { useState, useEffect } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface CelebrityTwinAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const CelebrityTwinApp: React.FC<CelebrityTwinAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [twinReport, setTwinReport] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const findTwin = async () => {
    if (!userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const prompt = `Find which global celebrity shares the closest birth chart match for: ${userProfile.firstName}.
    Details: Sex ${userProfile.sex}, Born ${userProfile.dob} at ${userProfile.tob} in ${userProfile.placeOfBirth.city}.
    Compare Sun, Moon, and Rising signs.
    Generate a "Cosmic Twin Report" comparing:
    - Careers & Ambitions
    - Public Image (Ascendant)
    - Famous Scandals or Challenges they both might face.
    IMPORTANT: Use Headers (###). Use Bold (**) for the celebrity name. Use colored markers for career vs scandal sections.
    Tone: Fun, slightly gossipy, yet astrolocially grounded.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setTwinReport(response.text || "Your celestial mirror is currently fogged.");
    } catch (error) {
      setTwinReport("Failed to locate your famous counterpart.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!twinReport) return;
    navigator.clipboard.writeText(twinReport);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  useEffect(() => {
    if (userProfile) findTwin();
  }, [userProfile]);

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-3xl font-black text-yellow-500 mb-8 mt-10" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-amber-400 font-black" {...props} />,
    p: ({node, ...props}: any) => <p className="leading-relaxed mb-4 last:mb-0" {...props} />,
    em: ({node, ...props}: any) => <em className="text-yellow-300 italic" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`w-12 h-12 flex items-center justify-center rounded-full transition-all shadow-lg border-2 ${isLight ? 'bg-white border-purple-50 text-purple-600 hover:border-purple-400' : 'bg-slate-900 border-white/5 text-purple-400 hover:border-white/20'}`} title="Back to Apps">
             <i className="fa-solid fa-arrow-left text-lg"></i>
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Celebrity Twin</h2>
           <div className="w-12" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-people-group text-5xl text-yellow-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Identity Verification Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">We need your birth data to scan the database of famous charts and find your twin.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-yellow-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-yellow-500/20">Set Up Profile</button>
          </div>
        ) : loading ? (
          <div className="flex flex-col items-center justify-center p-20 gap-6">
            <div className="w-16 h-16 rounded-full border-4 border-yellow-500 border-t-transparent animate-spin"></div>
            <p className="text-lg font-serif italic animate-pulse">Scanning the Hall of Fame...</p>
          </div>
        ) : (
          <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden transition-all duration-500 ${
            isLight ? 'bg-white border-purple-50' : 'bg-slate-900/40 border-yellow-500/10 backdrop-blur-xl'
          }`}>
            <div className="absolute top-0 left-0 w-full h-3 bg-gradient-to-r from-yellow-400 via-amber-500 to-orange-600"></div>
            <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
              <ReactMarkdown components={markdownComponents}>{twinReport || ""}</ReactMarkdown>
            </div>
            <div className="mt-12 flex flex-wrap gap-4 items-center">
              <button onClick={findTwin} className="flex items-center gap-3 px-8 py-4 rounded-2xl border-2 border-yellow-500/20 text-[10px] font-black uppercase tracking-widest hover:bg-yellow-600 hover:text-white transition-all shadow-lg">
                <i className="fa-solid fa-magnifying-glass"></i>
                Find Another Match
              </button>
              <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-yellow-500/20 hover:bg-yellow-600 hover:text-white'}`}>
                <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                {copied ? 'Copied' : 'Copy Twin Report'}
              </button>
            </div>
          </div>
        )}

        <button onClick={onBack} className={`mt-16 mb-8 px-12 py-5 rounded-2xl font-black uppercase tracking-widest transition-all shadow-xl hover:scale-105 active:scale-95 ${isLight ? 'bg-white border-2 border-purple-100 text-purple-600' : 'bg-slate-900 border-2 border-white/5 text-purple-400'}`}>
          <i className="fa-solid fa-arrow-left mr-3"></i>
          Back to Apps
        </button>
      </div>
    </div>
  );
};

export default CelebrityTwinApp;