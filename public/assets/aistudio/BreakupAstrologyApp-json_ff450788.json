
import React, { useState } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface BreakupAstrologyAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const BreakupAstrologyApp: React.FC<BreakupAstrologyAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [exDob, setExDob] = useState("");
  const [breakupDate, setBreakupDate] = useState("");
  const [report, setReport] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const performAutopsy = async () => {
    if (!exDob || !breakupDate || !userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const prompt = `Perform a "Relationship Autopsy" based on Astrology:
    User: Born ${userProfile.dob}.
    Ex: Born ${exDob}.
    Breakup Date: ${breakupDate}.
    Analyze:
    1. The Planetary Culprits: Which transit planets triggered the split (e.g., Saturn square Moon, Mars retrograde)?
    2. The Soul Lesson: Why did this relationship end for your growth?
    3. Cosmic Recovery Timeline: When will the emotional tides settle for a new beginning?
    IMPORTANT: Use Headers (###). Use bold (**) for the planets involved. Use a sympathetic yet firm tone. Color-code the recovery dates.
    Tone: Healing, insightful, and practical.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setReport(response.text || "The archives of this bond are currently sealed.");
    } catch (error) {
      setReport("The healing energy for this report failed to manifest.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!report) return;
    navigator.clipboard.writeText(report);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-4xl font-black text-slate-400 mb-10 mt-12 tracking-tighter" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-indigo-400 font-black text-2xl" {...props} />,
    p: ({node, ...props}: any) => <p className="leading-relaxed font-serif italic text-xl mb-4 last:mb-0" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`flex items-center gap-2 text-xs font-black uppercase tracking-widest transition-all ${isLight ? 'text-purple-600' : 'text-purple-400'}`}>
             <i className="fa-solid fa-arrow-left"></i>
             Back to Apps
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter text-slate-500">Breakup Astrology</h2>
           <div className="w-20" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-heart-broken text-5xl text-slate-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Profile Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">To perform a relationship autopsy, we need your celestial signature.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-slate-700 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-slate-500/20">Set Up Profile</button>
          </div>
        ) : (
          <div className="w-full space-y-8">
            <div className={`p-8 rounded-[3rem] border-2 shadow-xl ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                  <label className="text-[10px] uppercase font-black tracking-widest mb-1 block opacity-60">Ex's Birth Date</label>
                  <input type="date" className={`w-full p-3 rounded-xl border outline-none ${isLight ? 'bg-white border-slate-200' : 'bg-white/5 border-white/10 text-white'}`} value={exDob} onChange={e => setExDob(e.target.value)} />
                </div>
                <div>
                  <label className="text-[10px] uppercase font-black tracking-widest mb-1 block opacity-60">Date of Breakup</label>
                  <input type="date" className={`w-full p-3 rounded-xl border outline-none ${isLight ? 'bg-white border-slate-200' : 'bg-white/5 border-white/10 text-white'}`} value={breakupDate} onChange={e => setBreakupDate(e.target.value)} />
                </div>
              </div>
              <button 
                disabled={loading || !exDob || !breakupDate}
                onClick={performAutopsy}
                className="w-full py-5 rounded-2xl bg-gradient-to-tr from-slate-600 to-slate-900 text-white text-[11px] font-black uppercase tracking-[0.4em] shadow-xl hover:scale-[1.02] active:scale-95 transition-all disabled:opacity-30"
              >
                {loading ? 'Analyzing the Wounds of Time...' : 'Perform Relationship Autopsy'}
              </button>
            </div>

            {report && !loading && (
              <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden animate-in fade-in slide-in-from-top-4 duration-1000 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/40 border-slate-500/10 backdrop-blur-xl'}`}>
                <div className="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-slate-400 via-slate-600 to-black"></div>
                <div className="absolute top-6 right-8">
                   <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-slate-500/20 hover:bg-slate-700 hover:text-white'}`}>
                      <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                      {copied ? 'Autopsy Copied' : 'Copy Autopsy'}
                   </button>
                </div>
                <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
                  <ReactMarkdown components={markdownComponents}>{report}</ReactMarkdown>
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
};

export default BreakupAstrologyApp;
