
import React, { useState } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface IsHeTheOneAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const IsHeTheOneApp: React.FC<IsHeTheOneAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [partnerTraits, setPartnerTraits] = useState("");
  const [currentStep, setCurrentStep] = useState<'input' | 'quiz' | 'result'>('input');
  const [questions, setQuestions] = useState<any[]>([]);
  const [answers, setAnswers] = useState<number[]>([]);
  const [result, setResult] = useState<string | null>(null);
  const isLight = theme === ThemeMode.LIGHT;

  const generateQuiz = async () => {
    if (!partnerTraits.trim() || !userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const prompt = `Act as a Master Relationship Astrologer. User (Female) Born: ${userProfile.dob}. She is dating someone with these traits: "${partnerTraits}".
    Generate a 5-question multi-choice quiz to determine if he is 'The One' based on her natal chart (especially 7th house and Mars) and his characteristics.
    Each question must have 4 options reflecting degrees of alignment.
    Return JSON: { "quiz": [{ "question": "...", "options": ["...", "...", "...", "..."] }] }`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
        config: { responseMimeType: "application/json" }
      });
      const data = JSON.parse(response.text || "{}");
      setQuestions(data.quiz || []);
      setCurrentStep('quiz');
    } catch (error) {
      alert("Connection to the Oracle failed.");
    } finally {
      setLoading(false);
    }
  };

  const calculateResult = async () => {
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    const score = answers.reduce((a, b) => a + b, 0);
    
    const prompt = `Based on a score of ${score}/20 and partner traits: "${partnerTraits}", provide a final cosmic verdict for ${userProfile?.firstName}.
    Is he the one? Analyze the spiritual and emotional bond.
    Provide:
    ### 🤵 The Verdict
    ### ✨ Soul Purpose Together
    ### 🔭 Future Transits
    Tone: Empowering, truthful, and sophisticated.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setResult(response.text || "");
      setCurrentStep('result');
    } catch (error) {
      alert("The stars are hazy right now.");
    } finally {
      setLoading(false);
    }
  };

  const markdownComponents = {
    h3: ({node, ...props}: any) => <h3 className="text-2xl font-black text-blue-500 mb-6 tracking-tight" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-indigo-400 font-black" {...props} />,
    p: ({node, ...props}: any) => <p className="leading-relaxed text-lg mb-4 last:mb-0" {...props} />,
    em: ({node, ...props}: any) => <em className="text-indigo-300 italic" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`flex items-center gap-2 text-xs font-black uppercase tracking-widest transition-all ${isLight ? 'text-blue-600' : 'text-blue-400'}`}>
             <i className="fa-solid fa-arrow-left"></i>
             Back to Apps
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Is He The One?</h2>
           <div className="w-20" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-blue-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-mars text-5xl text-blue-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Birth Chart Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">We need your birth data to check your romantic destiny before we analyze his profile.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-blue-600 text-white font-black uppercase tracking-widest shadow-xl shadow-blue-500/20">Set Up Profile</button>
          </div>
        ) : currentStep === 'input' ? (
          <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-xl ${isLight ? 'bg-white border-blue-50' : 'bg-slate-900/60 border-white/5'}`}>
            <h3 className="text-xl font-serif font-black mb-6">Describe his personality and behavior:</h3>
            <textarea 
              className={`w-full p-4 rounded-2xl border-2 outline-none mb-6 h-40 ${isLight ? 'bg-slate-50' : 'bg-white/5 text-white'}`}
              placeholder="He is very kind, works in technology, can be a bit stubborn during arguments..."
              value={partnerTraits}
              onChange={(e) => setPartnerTraits(e.target.value)}
            />
            <button onClick={generateQuiz} disabled={loading || !partnerTraits.trim()} className="w-full py-5 rounded-2xl bg-blue-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all">
              {loading ? 'Consulting Mars...' : 'Start Matching Quiz'}
            </button>
          </div>
        ) : currentStep === 'quiz' ? (
          <div className="w-full max-w-xl space-y-6">
            <h3 className="text-xl font-serif font-black text-center">Inquiry {answers.length + 1} of {questions.length}</h3>
            <div className={`p-8 rounded-[2.5rem] border-2 shadow-xl ${isLight ? 'bg-white border-blue-50' : 'bg-slate-900 border-white/5'}`}>
              <p className="text-lg font-serif italic mb-8">{questions[answers.length]?.question}</p>
              <div className="grid gap-3">
                {questions[answers.length]?.options.map((opt: string, idx: number) => (
                  <button key={idx} onClick={() => {
                    const newAnswers = [...answers, idx + 1];
                    if (newAnswers.length === questions.length) {
                      setAnswers(newAnswers);
                      calculateResult();
                    } else {
                      setAnswers(newAnswers);
                    }
                  }} className="p-4 rounded-xl border-2 text-left hover:bg-blue-600 hover:text-white transition-all text-sm font-bold">
                    {opt}
                  </button>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden ${isLight ? 'bg-white border-blue-50' : 'bg-slate-900/40'}`}>
            <div className="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-blue-400 to-indigo-600"></div>
            <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
              <ReactMarkdown components={markdownComponents}>{result || ""}</ReactMarkdown>
            </div>
            <button onClick={() => setCurrentStep('input')} className="mt-12 px-8 py-4 rounded-xl border-2 border-blue-500/20 text-[10px] font-black uppercase tracking-widest hover:bg-blue-600 hover:text-white transition-all">Try Another Partner</button>
          </div>
        )}
        
        {loading && (
          <div className="fixed inset-0 z-[120] bg-black/60 backdrop-blur-sm flex flex-col items-center justify-center gap-4">
             <div className="w-12 h-12 rounded-full border-4 border-blue-500 border-t-transparent animate-spin"></div>
             <p className="text-white font-serif italic">Decoding the romantic destiny...</p>
          </div>
        )}
      </div>
    </div>
  );
};

export default IsHeTheOneApp;
