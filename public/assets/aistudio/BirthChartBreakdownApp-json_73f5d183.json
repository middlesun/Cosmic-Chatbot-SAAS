const BirthChartBreakdownApp: React.FC<BirthChartBreakdownAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [activeCategory, setActiveCategory] = useState<string>(CATEGORIES[0].id);
  const [selectedSub, setSelectedSub] = useState<string | null>(null);
  const [answer, setAnswer] = useState<string | null>(null);
  const [cachedAnswers, setCachedAnswers] = useState<Record<string, string>>(() => {
    const saved = localStorage.getItem('astro_breakdown_cache');
    return saved ? JSON.parse(saved) : {};
  });
  const [copied, setCopied] = useState(false);
  
  const abortControllerRef = useRef<AbortController | null>(null);
  const isLight = theme === ThemeMode.LIGHT;

  const currentCategory = CATEGORIES.find(c => c.id === activeCategory);

  useEffect(() => {
    localStorage.setItem('astro_breakdown_cache', JSON.stringify(cachedAnswers));
  }, [cachedAnswers]);

  const stopGeneration = () => {
    if (abortControllerRef.current) {
      abortControllerRef.current.abort();
      setLoading(false);
    }
  };

  const askOracle = async (subButton: { label: string, prompt: string }) => {
    if (!userProfile) return;
    
    const cacheKey = `${activeCategory}-${subButton.label}`;
    if (cachedAnswers[cacheKey]) {
      setSelectedSub(subButton.label);
      setAnswer(cachedAnswers[cacheKey]);
      return;
    }

    setSelectedSub(subButton.label);
    setLoading(true);
    setAnswer(null);
    
    abortControllerRef.current = new AbortController();
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const now = new Date();
    const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });

    const context = `[AUTHORITATIVE CURRENT DATE & TIME]: ${dateStr}, ${timeStr}. User Born: ${userProfile.dob} at ${userProfile.tob || 'Unknown Time'} in ${userProfile.placeOfBirth.city}, ${userProfile.placeOfBirth.country}. Sex: ${userProfile.sex}.`;
    const fullPrompt = `Act as an Elite Predictive Astrologer performing a "BirthChart Breakdown" for ${userProfile.firstName}.
    ${context}
    
    Analysis Task: ${subButton.prompt}
    
    Required:
    1. Technical Accuracy: Use real house numbers, planetary aspects, and nakshatras.
    2. One-Click Speed: Get straight to the point.
    3. Practical Insight: Provide a specific suggestion or warning.
    
    Tone: Sophisticated, insightful, slightly mentor-like.
    Format: Return 2-3 detailed paragraphs with Markdown. Highlight specific placements in **bold**.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: fullPrompt,
      });
      
      if (abortControllerRef.current?.signal.aborted) return;

      const generatedText = response.text || "";
      setAnswer(generatedText);
      setCachedAnswers(prev => ({ ...prev, [cacheKey]: generatedText }));
    } catch (error: any) {
      if (error?.name === 'AbortError') return;
      setAnswer("The cosmic data stream was interrupted. Please try again.");
    } finally {
      setLoading(false);
      abortControllerRef.current = null;
    }
  };

  const handleCopy = () => {
    if (!answer) return;
    navigator.clipboard.writeText(answer);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const markdownComponents = {
    h1: ({node, ...props}: any) => <h1 className="text-3xl sm:text-4xl font-black text-rose-500 mb-6 tracking-tighter" {...props} />,
    h2: ({node, ...props}: any) => <h2 className="text-2xl sm:text-3xl font-black text-pink-500 mb-4 tracking-tight" {...props} />,
    h3: ({node, ...props}: any) => <h3 className="text-xl sm:text-2xl font-black text-fuchsia-500 mb-3" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-indigo-400 font-black" {...props} />,
    em: ({node, ...props}: any) => <em className="text-amber-400 not-italic font-bold underline decoration-amber-500/30" {...props} />,
    li: ({node, ...props}: any) => <li className="mb-3 list-disc ml-6 opacity-90" {...props} />,
    p: ({node, ...props}: any) => <p className="mb-4 last:mb-0 leading-relaxed" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in duration-700 custom-scrollbar">
      <div className="max-w-7xl mx-auto flex flex-col items-center">
        <div className="w-full mb-12 flex items-center justify-between">
           <button onClick={onBack} className={`w-12 h-12 flex items-center justify-center rounded-full transition-all shadow-lg border-2 ${isLight ? 'bg-white border-indigo-50 text-indigo-600 hover:border-indigo-400' : 'bg-slate-900 border-white/5 text-indigo-400 hover:border-white/20'}`} title="Back to Apps">
             <i className="fa-solid fa-arrow-left text-lg"></i>
           </button>
           <h2 className="text-3xl font-serif font-black tracking-tighter bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 bg-clip-text text-transparent">BirthChart Breakdown</h2>
           <div className="w-12" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-indigo-50 shadow-xl' : 'bg-slate-900/60 border-white/5 shadow-2xl'}`}>
            <i className="fa-solid fa-burst text-6xl text-indigo-500 mb-6 animate-float"></i>
            <h3 className="text-3xl font-serif font-black mb-4">Celestial Blueprint Missing</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto text-lg">We need your exact birth timestamp to calculate the precise geometry of your destiny across the 12 houses.</p>
            <button onClick={onOpenProfile} className="px-12 py-5 rounded-2xl bg-indigo-600 text-white font-black uppercase tracking-widest shadow-xl shadow-indigo-500/30 hover:scale-105 active:scale-95 transition-all">Setup My Profile</button>
          </div>
        ) : (
          <div className="w-full grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            {/* Mobile Combined Dropdown Group */}
            <div className="lg:hidden w-full mb-8">
              <div className={`p-4 rounded-[2.5rem] border-2 shadow-xl flex flex-col gap-3 ${isLight ? 'bg-white border-indigo-50' : 'bg-slate-950/40 border-white/5 backdrop-blur-xl'}`}>
                <div className="relative">
                  <select
                    value={activeCategory}
                    onChange={(e) => { setActiveCategory(e.target.value); setAnswer(null); setSelectedSub(null); }}
                    className={`w-full p-4 pr-10 rounded-2xl border-2 outline-none font-black uppercase tracking-widest text-[11px] appearance-none ${isLight ? 'bg-indigo-50 border-indigo-100 text-indigo-600' : 'bg-slate-900 border-white/10 text-white'}`}
                  >
                    {CATEGORIES.map(cat => (
                      <option key={cat.id} value={cat.id} className={isLight ? 'bg-white text-slate-900' : 'bg-slate-900 text-white'}>{cat.title}</option>
                    ))}
                  </select>
                  <i className="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-[10px] opacity-40 pointer-events-none"></i>
                </div>
                
                <div className="relative">
                  <select
                    value={selectedSub || ''}
                    onChange={(e) => {
                      const sub = currentCategory?.subButtons.find(s => s.label === e.target.value);
                      if (sub) askOracle(sub);
                    }}
                    className={`w-full p-4 pr-10 rounded-2xl border-2 outline-none font-black uppercase tracking-widest text-[11px] appearance-none ${
                      isLight ? 'bg-slate-50 border-indigo-50 text-slate-700' : 'bg-white/5 border-white/10 text-slate-300'
                    }`}
                  >
                    <option value="" disabled className={isLight ? 'bg-white text-slate-400' : 'bg-slate-900 text-slate-500'}>Select an insight...</option>
                    {currentCategory?.subButtons.map(sub => (
                      <option key={sub.label} value={sub.label} className={isLight ? 'bg-white text-slate-900' : 'bg-slate-900 text-white'}>{sub.label}</option>
                    ))}
                  </select>
                  <i className="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-[10px] opacity-40 pointer-events-none"></i>
                </div>
              </div>
            </div>

            <div className="hidden lg:block lg:col-span-4 space-y-6">
              <div className={`p-6 rounded-[3rem] border-2 shadow-xl overflow-hidden relative ${isLight ? 'bg-white border-indigo-50' : 'bg-slate-950/40 border-white/5 backdrop-blur-xl'}`}>
                <div className="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500"></div>
                <p className="text-[10px] font-black uppercase tracking-[0.4em] opacity-40 mb-6 px-2">Choose Life Domain</p>
                <div className="flex flex-col gap-2">
                  {CATEGORIES.map(cat => (
                    <button
                      key={cat.id}
                      onClick={() => { setActiveCategory(cat.id); setAnswer(null); setSelectedSub(null); }}
                      className={`group flex items-center gap-4 p-4 rounded-2xl transition-all duration-500 ${
                        activeCategory === cat.id 
                        ? `bg-gradient-to-r ${cat.color} text-white shadow-lg scale-[1.02]`
                        : (isLight ? 'hover:bg-indigo-50 text-slate-500' : 'hover:bg-white/5 text-slate-400')
                      }`}
                    >
                      <div className={`w-10 h-10 rounded-xl flex items-center justify-center transition-transform duration-500 group-hover:rotate-12 ${
                        activeCategory === cat.id ? 'bg-white/20' : (isLight ? 'bg-slate-100' : 'bg-white/5')
                      }`}>
                        <i className={`${cat.icon} text-sm`}></i>
                      </div>
                      <span className="text-[11px] font-black uppercase tracking-widest">{cat.title}</span>
                      {activeCategory === cat.id && <i className="fa-solid fa-chevron-right ml-auto text-[10px] opacity-60"></i>}
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <div className="lg:col-span-8 flex flex-col gap-8">
              {currentCategory && (
                <div className={`p-8 rounded-[3.5rem] border-2 shadow-2xl transition-all duration-700 hidden lg:block ${isLight ? 'bg-white border-indigo-50' : `bg-slate-900 border-white/5`}`}>
                  <div className="flex items-center gap-4 mb-8">
                    <div className={`w-14 h-14 rounded-2xl bg-gradient-to-tr ${currentCategory.color} flex items-center justify-center text-white text-2xl shadow-lg`}>
                      <i className={currentCategory.icon}></i>
                    </div>
                    <div>
                      <h3 className="text-2xl font-serif font-black leading-none">{currentCategory.title}</h3>
                      <p className="text-[9px] uppercase font-black tracking-widest opacity-40 mt-1">Deep Natal Insights</p>
                    </div>
                  </div>

                  <div className="flex flex-wrap gap-4">
                    {currentCategory.subButtons.map(sub => (
                      <button
                        key={sub.label}
                        onClick={() => askOracle(sub)}
                        disabled={loading}
                        className={`group relative px-8 py-5 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all duration-500 overflow-hidden ${
                          selectedSub === sub.label
                          ? `bg-gradient-to-tr ${currentCategory.color} border-transparent text-white shadow-xl scale-105`
                          : (isLight ? 'bg-slate-50 border-indigo-50 text-slate-700 hover:border-indigo-400 hover:bg-white' : 'bg-white/5 border-white/10 text-slate-300 hover:border-white/30')
                        }`}
                      >
                        <span className="relative z-10">{sub.label}</span>
                        {cachedAnswers[`${activeCategory}-${sub.label}`] && selectedSub !== sub.label && (
                           <i className="fa-solid fa-circle-check absolute top-1 right-1 text-[8px] opacity-40"></i>
                        )}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <div className={`flex-1 min-h-[500px] rounded-[4rem] border-2 shadow-2xl relative overflow-hidden transition-all duration-1000 ${
                isLight ? 'bg-white border-indigo-100 shadow-indigo-200/40' : 'bg-slate-950 border-white/5'
              }`}>
                {loading ? (
                  <div className="h-full flex flex-col items-center justify-center gap-10 py-32 px-12 text-center animate-in fade-in duration-700">
                    <div className="relative w-24 h-24">
                      <div className="absolute inset-0 rounded-full border-4 border-indigo-500/10 border-t-indigo-500 animate-spin"></div>
                      <div className="absolute inset-4 rounded-full border-4 border-purple-500/10 border-b-purple-500 animate-spin [animation-duration:1.5s]"></div>
                      <div className="absolute inset-8 rounded-full border-4 border-pink-500/10 border-r-pink-500 animate-spin [animation-duration:2s]"></div>
                      <i className="fa-solid fa-dna absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-2xl text-indigo-500 animate-pulse"></i>
                    </div>
                    <div className="space-y-4">
                      <p className="text-2xl font-serif italic text-indigo-400 animate-pulse">Analysing your Birth chart..</p>
                      <p className="text-[10px] uppercase font-black tracking-[0.4em] opacity-30">Consulting the 12th House Masters</p>
                    </div>
                    <button 
                      onClick={stopGeneration}
                      className="px-8 py-3 rounded-xl border-2 border-rose-500/30 text-rose-500 text-[10px] font-black uppercase tracking-widest hover:bg-rose-500 hover:text-white transition-all shadow-lg z-20"
                    >
                      <i className="fa-solid fa-stop mr-2"></i>
                      Stop Channeling
                    </button>
                  </div>
                ) : answer ? (
                  <div className="p-10 md:p-16 animate-in slide-in-from-bottom-8 duration-1000">
                    <div className="flex items-center justify-between gap-4 mb-10 pb-8 border-b border-white/5">
                      <div className="flex items-center gap-5">
                        <div className={`w-16 h-16 rounded-3xl bg-gradient-to-tr ${currentCategory?.color} flex items-center justify-center text-white text-3xl shadow-xl animate-float`}>
                          <i className="fa-solid fa-sparkles"></i>
                        </div>
                        <div>
                          <h3 className="text-[10px] font-black uppercase tracking-[0.4em] text-indigo-500 mb-1">Celestial Revelation</h3>
                          <p className="text-3xl font-serif font-black tracking-tight">{selectedSub}</p>
                        </div>
                      </div>
                      <div className="flex gap-3">
                         <button 
                          onClick={handleCopy} 
                          title="Copy Analysis"
                          className={`w-12 h-12 rounded-2xl flex items-center justify-center transition-all border-2 ${
                            copied ? 'bg-emerald-500 border-emerald-500 text-white' : (isLight ? 'bg-slate-50 border-indigo-50 text-indigo-600 hover:bg-indigo-50' : 'bg-white/5 border-white/10 text-indigo-400 hover:bg-indigo-500/20')
                          }`}
                         >
                            <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                         </button>
                      </div>
                    </div>
                    <div className={`prose prose-xl max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
                      <ReactMarkdown components={markdownComponents}>{answer}</ReactMarkdown>
                    </div>
                  </div>
                ) : (
                  <div className="h-full flex flex-col items-center justify-center py-32 px-12 text-center group">
                    <div className="relative w-40 h-40 mb-10 flex items-center justify-center">
                       <div className="absolute inset-0 rounded-full bg-indigo-500/5 blur-[40px] group-hover:bg-indigo-500/20 transition-all duration-1000"></div>
                       <div className="relative">
                          <div className="w-24 h-24 rounded-full border-2 border-indigo-500/20 flex items-center justify-center animate-[spin_10s_linear_infinite]">
                             <i className="fa-solid fa-star text-[8px] text-indigo-500 absolute -top-1 left-1/2"></i>
                             <i className="fa-solid fa-star text-[8px] text-purple-500 absolute top-1/2 -right-1"></i>
                             <i className="fa-solid fa-star text-[8px] text-pink-500 absolute -bottom-1 left-1/2"></i>
                             <i className="fa-solid fa-star text-[8px] text-blue-500 absolute top-1/2 -left-1"></i>
                          </div>
                          <div className="absolute inset-0 flex items-center justify-center">
                             <div className="w-12 h-12 rounded-full border-2 border-white/5 flex items-center justify-center animate-[spin_15s_linear_infinite_reverse]">
                                <i className="fa-solid fa-moon text-[10px] text-white/20"></i>
                             </div>
                          </div>
                          <i className="fa-solid fa-earth-americas absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-3xl opacity-10 group-hover:opacity-40 transition-all duration-1000 group-hover:scale-125"></i>
                       </div>
                    </div>
                    <div className="space-y-4">
                      <p className="text-3xl font-serif italic text-indigo-400/40 font-black">Waiting for you to make a choice</p>
                      <p className="text-[10px] uppercase font-black tracking-[0.5em] opacity-20 max-w-xs mx-auto leading-relaxed">The Akashic records remain silent until you invoke the domain above.</p>
                    </div>
                  </div>
                )}
                <div className={`absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 transition-opacity duration-1000 ${loading || answer ? 'opacity-100' : 'opacity-10'}`}></div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default BirthChartBreakdownApp;