import React, { useState, useEffect } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface NumerologyAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const NumerologyApp: React.FC<NumerologyAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [report, setReport] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const generateReport = async () => {
    if (!userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const prompt = `Generate a comprehensive Numerology report for ${userProfile.firstName}.
    Details: Born ${userProfile.dob}. Full Birth Name: ${userProfile.firstName}.
    Calculate and interpret:
    - Life Path Number (based on date of birth)
    - Destiny Number (based on name vibrations)
    - Karmic Debt Numbers
    - Ideal Career Paths based on these frequencies
    - Love Compatibility profile
    IMPORTANT: Use Markdown tables for the numbers. Use bold (**) for the final numbers calculated. Use headers (###) for sections.
    Tone: Precise, professional, yet mystical. Highlight the key vibrations in a list.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setReport(response.text || "The numbers are silent. Please check back later.");
    } catch (error) {
      setReport("Calculations failed due to a cosmic interference.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!report) return;
    navigator.clipboard.writeText(report);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  useEffect(() => {
    if (userProfile) generateReport();
  }, [userProfile]);

  const markdownComponents = {
    h1: ({node, ...props}: any) => <h1 className="text-3xl font-black text-rose-500 mb-6" {...props} />,
    h2: ({node, ...props}: any) => <h2 className="text-2xl font-black text-pink-500 mb-4" {...props} />,
    h3: ({node, ...props}: any) => <h3 className="text-xl font-black text-blue-400 mb-6 mt-8" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-indigo-400 font-black" {...props} />,
    table: ({node, ...props}: any) => <table className="w-full border-collapse mb-8" {...props} />,
    th: ({node, ...props}: any) => <th className="bg-blue-500/10 p-4 font-black uppercase text-xs" {...props} />,
    td: ({node, ...props}: any) => <td className="p-4 border-b border-white/5" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`w-12 h-12 flex items-center justify-center rounded-full transition-all shadow-lg border-2 ${isLight ? 'bg-white border-purple-50 text-purple-600 hover:border-purple-400' : 'bg-slate-900 border-white/5 text-purple-400 hover:border-white/20'}`} title="Back to Apps">
             <i className="fa-solid fa-arrow-left text-lg"></i>
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Numerology App</h2>
           <div className="w-12" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-purple-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-hashtag text-5xl text-blue-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Name & Date Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">Numerology is an exact science of vibrations. We need your birth details to decode your path.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-blue-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-blue-500/20">Set Up Profile</button>
          </div>
        ) : loading ? (
          <div className="flex flex-col items-center justify-center p-20 gap-6">
            <div className="w-16 h-16 rounded-full border-4 border-blue-500 border-t-transparent animate-spin"></div>
            <p className="text-lg font-serif italic animate-pulse">Calculating your vibrational frequencies...</p>
          </div>
        ) : (
          <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden transition-all duration-500 ${
            isLight ? 'bg-white border-purple-50' : 'bg-slate-900/40 border-blue-500/10 backdrop-blur-xl'
          }`}>
            <div className="absolute top-0 left-0 w-full h-3 bg-gradient-to-r from-blue-400 via-indigo-500 to-purple-600"></div>
            <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
              <ReactMarkdown components={markdownComponents}>{report || ""}</ReactMarkdown>
            </div>
            <div className="mt-12 flex flex-wrap gap-4 items-center">
              <button onClick={generateReport} className="flex items-center gap-3 px-8 py-4 rounded-2xl border-2 border-blue-500/20 text-[10px] font-black uppercase tracking-widest hover:bg-blue-600 hover:text-white transition-all">
                <i className="fa-solid fa-calculator"></i>
                Recalculate Numbers
              </button>
              <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-blue-500/20 hover:bg-blue-600 hover:text-white'}`}>
                <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                {copied ? 'Copied' : 'Copy Report'}
              </button>
            </div>
          </div>
        )}

        <button onClick={onBack} className={`mt-16 mb-8 px-12 py-5 rounded-2xl font-black uppercase tracking-widest transition-all shadow-xl hover:scale-105 active:scale-95 ${isLight ? 'bg-white border-2 border-purple-100 text-purple-600' : 'bg-slate-900 border-2 border-white/5 text-purple-400'}`}>
          <i className="fa-solid fa-arrow-left mr-3"></i>
          Back to Apps
        </button>
      </div>
    </div>
  );
};

export default NumerologyApp;