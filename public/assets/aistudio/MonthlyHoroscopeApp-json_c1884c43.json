import React, { useState, useEffect } from 'react';
import ReactMarkdown from 'react-markdown';
import { ThemeMode, UserProfile } from '../types';
import { GoogleGenAI } from '@google/genai';

interface MonthlyHoroscopeAppProps {
  theme: ThemeMode;
  userProfile: UserProfile | null;
  onBack: () => void;
  onOpenProfile: () => void;
}

const MonthlyHoroscopeApp: React.FC<MonthlyHoroscopeAppProps> = ({ theme, userProfile, onBack, onOpenProfile }) => {
  const [loading, setLoading] = useState(false);
  const [horoscope, setHoroscope] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const isLight = theme === ThemeMode.LIGHT;

  const fetchHoroscope = async () => {
    if (!userProfile) return;
    setLoading(true);
    const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
    
    const now = new Date();
    const monthYear = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

    const prompt = `Act as a Grand Master Astrologer. GENERATE A MONTHLY REPORT FOR: ${monthYear}.
    Generate a hyper-personalized monthly forecast for ${userProfile.firstName}. 
    User Context: Sex ${userProfile.sex}, Born ${userProfile.dob} at ${userProfile.tob || 'Unknown Time'}.
    
    Predictive Logic:
    1. Analyze the major outer planet movements (Saturn, Jupiter, Pluto) for this month.
    2. Focus on New and Full Moon cycles and their house impact.
    3. Discuss the "Karmic Lesson of the Month" and how to navigate it.
    
    Required Sections:
    ### 🌑 Monthly Manifestation Title
    ### 🔭 Long-Range Celestial Outlook
    (Detailed analysis of planetary retrogrades and shifts this month)
    ### 💼 Professional Evolution
    (Monthly goals and abundance potential)
    ### ❤️ Relationship Dynamics
    (How to handle social and romantic tides)
    ### ✨ Soul Mastery Tip
    (A high-level energetic strategy for the month)

    IMPORTANT: Use Markdown headers (###). Use bold (**) for specific dates and degrees. Use italic (*) for soul guidance.
    Tone: Sophisticated, authoritative, and empowering.`;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: prompt,
      });
      setHoroscope(response.text || "The monthly stars are currently aligning. Check back soon.");
    } catch (error) {
      setHoroscope("The cosmic connection was interrupted. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  const handleCopy = () => {
    if (!horoscope) return;
    navigator.clipboard.writeText(horoscope);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  useEffect(() => {
    if (userProfile) fetchHoroscope();
  }, [userProfile]);

  const markdownComponents = {
    h1: ({node, ...props}: any) => <h1 className="text-3xl font-black text-rose-500 mb-6 tracking-tighter" {...props} />,
    h2: ({node, ...props}: any) => <h2 className="text-2xl font-black text-pink-500 mb-4 tracking-tight" {...props} />,
    h3: ({node, ...props}: any) => <h3 className="text-xl font-black text-fuchsia-500 mb-6 mt-8" {...props} />,
    strong: ({node, ...props}: any) => <strong className="text-indigo-400 font-black" {...props} />,
    em: ({node, ...props}: any) => <em className="text-rose-400 not-italic font-bold" {...props} />,
    li: ({node, ...props}: any) => <li className="mb-2 list-disc ml-6" {...props} />,
  };

  return (
    <div className="flex-1 overflow-y-auto px-4 py-8 md:py-16 w-full animate-in fade-in slide-in-from-bottom-4 duration-700 custom-scrollbar">
      <div className="max-w-4xl mx-auto flex flex-col items-center">
        <div className="w-full mb-8 flex items-center justify-between">
           <button onClick={onBack} className={`w-12 h-12 flex items-center justify-center rounded-full transition-all shadow-lg border-2 ${isLight ? 'bg-white border-pink-50 text-pink-600 hover:border-pink-400' : 'bg-slate-900 border-white/5 text-pink-400 hover:border-white/20'}`} title="Back to Apps">
             <i className="fa-solid fa-arrow-left text-lg"></i>
           </button>
           <h2 className="text-2xl font-serif font-black tracking-tighter">Monthly Horoscope</h2>
           <div className="w-12" />
        </div>

        {!userProfile ? (
          <div className={`p-12 rounded-[3rem] text-center border-2 ${isLight ? 'bg-white border-pink-50' : 'bg-slate-900/60 border-white/5'}`}>
            <i className="fa-solid fa-calendar-days text-5xl text-pink-500 mb-6"></i>
            <h3 className="text-2xl font-serif font-black mb-4">Natal Sync Required</h3>
            <p className="opacity-70 mb-8 max-w-sm mx-auto">Monthly forecasts provide long-term strategic guidance. We need your birth details to track the slow-moving planets across your destiny map.</p>
            <button onClick={onOpenProfile} className="px-10 py-4 rounded-2xl bg-pink-600 text-white font-black uppercase tracking-widest hover:scale-105 transition-all shadow-xl shadow-pink-500/20">Set Up Profile</button>
          </div>
        ) : loading ? (
          <div className="flex flex-col items-center justify-center p-20 gap-6">
            <div className="w-16 h-16 rounded-full border-4 border-pink-500 border-t-transparent animate-spin"></div>
            <p className="text-lg font-serif italic animate-pulse">Calculating monthly lunar cycles...</p>
          </div>
        ) : (
          <div className={`w-full p-8 md:p-12 rounded-[3rem] border-2 shadow-2xl relative overflow-hidden transition-all duration-500 ${
            isLight ? 'bg-white border-pink-50' : 'bg-slate-900/40 border-pink-500/10 backdrop-blur-xl'
          }`}>
            <div className="absolute top-0 left-0 w-full h-3 bg-gradient-to-r from-amber-400 via-pink-500 to-rose-600"></div>
            <div className={`prose prose-lg max-w-none ${isLight ? 'prose-slate' : 'prose-invert'}`}>
              <ReactMarkdown components={markdownComponents}>{horoscope || ""}</ReactMarkdown>
            </div>
            <div className="mt-12 pt-8 border-t border-white/5 flex flex-wrap gap-4">
              <button onClick={fetchHoroscope} className="flex items-center gap-3 px-8 py-4 rounded-2xl border-2 border-pink-500/20 text-[10px] font-black uppercase tracking-widest hover:bg-pink-600 hover:text-white transition-all">
                <i className="fa-solid fa-rotate"></i>
                Refresh Month
              </button>
              <button onClick={handleCopy} className={`flex items-center gap-3 px-8 py-4 rounded-2xl border-2 text-[10px] font-black uppercase tracking-widest transition-all ${copied ? 'bg-emerald-600 text-white border-emerald-600' : 'border-pink-500/20 hover:bg-pink-600 hover:text-white'}`}>
                <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                {copied ? 'Copied' : 'Copy Forecast'}
              </button>
            </div>
          </div>
        )}

        <button onClick={onBack} className={`mt-16 mb-8 px-12 py-5 rounded-2xl font-black uppercase tracking-widest transition-all shadow-xl hover:scale-105 active:scale-95 ${isLight ? 'bg-white border-2 border-purple-100 text-purple-600' : 'bg-slate-900 border-2 border-white/5 text-purple-400'}`}>
          <i className="fa-solid fa-arrow-left mr-3"></i>
          Back to Apps
        </button>
      </div>
    </div>
  );
};

export default MonthlyHoroscopeApp;